            <span class="mf-privacy-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Legal & Data Governance
            </span>
            <span class="mf-privacy-meta">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Last Updated: August 2026
            </span>
            <span class="mf-privacy-meta">•</span>
            <span class="mf-privacy-meta">Version 2.4</span>
        </div>

        <h1 class="mf-privacy-title">MoneyFlow Privacy Policy</h1>
        <p class="mf-privacy-subtitle">
            At MoneyFlow, safeguarding your privacy and personal financial information is foundational to everything we build. 
            This policy outlines our rigorous standards for data collection, encryption, regulatory compliance, and your statutory rights.
        </p>

        <!-- Key Commitments Highlights Banner -->
        <div class="mf-privacy-highlights">
            <div class="mf-highlight-card">
                <div class="mf-highlight-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <div>
                    <div class="mf-highlight-title">AES-256 Encryption</div>
                    <p class="mf-highlight-desc">All financial data encrypted at rest and in transit via TLS 1.3.</p>
                </div>
            </div>

            <div class="mf-highlight-card">
                <div class="mf-highlight-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                    </svg>
                </div>
                <div>
                    <div class="mf-highlight-title">Zero Data Selling</div>
                    <p class="mf-highlight-desc">We never sell, rent, or monetize your personal or transaction data.</p>
                </div>
            </div>

            <div class="mf-highlight-card">
                <div class="mf-highlight-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="8.5" cy="7" r="4"></circle>
                        <polyline points="17 11 19 13 23 9"></polyline>
                    </svg>
                </div>
                <div>
                    <div class="mf-highlight-title">User Consent & Control</div>
                    <p class="mf-highlight-desc">Complete autonomy over your data export, permissions, and settings.</p>
                </div>
            </div>

            <div class="mf-highlight-card">
                <div class="mf-highlight-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 11 12 14 22 4"></polyline>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                    </svg>
                </div>
                <div>
                    <div class="mf-highlight-title">Strict Compliance</div>
                    <p class="mf-highlight-desc">Fully compliant with GLBA, GDPR, CCPA/CPRA, and banking regulations.</p>
                </div>
            </div>
        </div>
    </div>
</section>

