@{
    ViewData["Title"] = "Sign In - MoneyFlow";
    ViewData["BodyClass"] = "mf-page-auth";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="mf-auth-split-wrapper">
    <!-- Left Branded Message Panel -->
    <div class="mf-login-brand-panel" aria-label="Brand Overview">
        <div class="mf-login-brand-bg-pattern" aria-hidden="true"></div>
        
        <div class="mf-login-brand-card">
            <div class="mf-brand-card-logo">
                <span class="mf-brand-card-logo-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="#00193C" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L2 8.5H22L12 2Z" />
                        <rect x="4.25" y="10.5" width="3" height="8.5" rx="1.5" />
                        <rect x="10.5" y="10.5" width="3" height="8.5" rx="1.5" />
                        <rect x="16.75" y="10.5" width="3" height="8.5" rx="1.5" />
                        <rect x="2" y="21" width="20" height="2" rx="1" />
                    </svg>
                </span>
                <span class="mf-brand-card-logo-text">MoneyFlow</span>
            </div>

            <h1 class="mf-login-brand-heading">Welcome Back.</h1>
            <p class="mf-login-brand-desc">
                Securely access your MoneyFlow account and manage your finances with confidence. 
                Our institutional-grade infrastructure ensures your assets are protected while providing unparalleled agility.
            </p>
        </div>
    </div>

    <!-- Right Sign In Form Panel -->
    <div class="mf-login-form-panel">
        <div class="mf-auth-form-card" id="login-card">
            <div class="mf-auth-card-header">
                <h2 class="mf-auth-card-title">Sign in</h2>
                <p class="mf-auth-card-subtitle">Please enter your details to access your dashboard.</p>
            </div>

            <form id="login-form" method="post" onsubmit="return false;" novalidate>
                <!-- Email Input -->
                <div class="mf-form-group">
                    <label class="mf-form-label" for="login-email">Email Address</label>
                    <div class="mf-input-wrapper mf-input-has-icon-left">
                        <span class="mf-input-icon-left" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                        </span>
                        <input type="email" 
                               class="mf-form-control" 
                               id="login-email" 
                               name="email" 
                               placeholder="name@company.com" 
                               autocomplete="email" 
                               required />
                    </div>
                </div>

                <!-- Password Input (With Visual Error State Demonstration Option) -->
                <div class="mf-form-group">
                    <div class="mf-label-row">
                        <label class="mf-form-label mb-0" for="login-password">Password</label>
                        <a href="#forgot-password" class="mf-forgot-link" id="link-forgot-password">Forgot password?</a>
                    </div>
                    <div class="mf-input-wrapper mf-input-has-icon-left mf-input-has-icon-right">
                        <span class="mf-input-icon-left" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </span>
                        <input type="password" 
                               class="mf-form-control" 
                               id="login-password" 
                               name="password" 
                               placeholder="••••••••" 
                               autocomplete="current-password" 
                               required />
                        <button type="button" 
                                class="mf-input-icon-btn mf-password-toggle-btn" 
                                data-target="login-password" 
                                aria-label="Toggle password visibility" 
                                id="btn-toggle-login-password">
                            <svg class="mf-eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="mf-eye-closed d-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    <!-- Visual Error State Indicator (Hidden by default, can be toggled) -->
                    <div class="mf-error-feedback d-none" id="login-password-error">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                        </svg>
                        <span>The password you entered is incorrect.</span>
                    </div>
                </div>

                <!-- Remember Me Checkbox -->
                <div class="mf-auth-options-row">
                    <label class="mf-checkbox-wrap" for="login-remember">
                        <input type="checkbox" class="mf-checkbox" id="login-remember" name="rememberMe" />
                        <span class="mf-checkbox-label">Remember me</span>
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn mf-btn-primary mf-btn-auth-submit" id="btn-login-submit">
                    <span>Login securely</span>
                    <svg class="mf-btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </button>

                <!-- Switch to Register Link -->
                <div class="mf-auth-switch-link">
                    <span>Don't have an account?</span>
                    <a asp-controller="Auth" asp-action="Register" id="link-goto-register">Create an account</a>
                </div>
            </form>
        </div>
    </div>
</div>
