@model ExternalRegisterVM

@{
	ViewData["Title"] = "Complete your Account";
	ViewData["BodyClass"] = "mf-page-auth";
}

@section Styles {
	<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="mf-register-page-wrapper">
	<div class="mf-register-card" id="external-register-card">
		<div class="mf-register-header">
			<h1 class="mf-register-title">Complete your Account</h1>
			<p class="mf-register-subtitle">Your Google account is connected. Add the banking details we still need.</p>
		</div>

		<form asp-action="ExternalRegister" id="external-register-form" method="post">
			<div asp-validation-summary="ModelOnly"
				 class="text-danger"
				 role="alert">
			</div>

			<input type="hidden" asp-for="Email" />

			<div class="mf-register-section">
				<h2 class="mf-register-section-title">Personal Information</h2>

				<div class="row g-3">
					<div class="col-sm-6">
						<label class="mf-form-label" asp-for="FirstName">First Name <span class="text-danger">*</span></label>
						<input type="text"
							   class="mf-form-control"
							   asp-for="FirstName"
							   placeholder="John"
							   autocomplete="given-name" />
						<span asp-validation-for="FirstName"></span>
					</div>

					<div class="col-sm-6">
						<label class="mf-form-label" asp-for="LastName">Last Name <span class="text-danger">*</span></label>
						<input type="text"
							   class="mf-form-control"
							   asp-for="LastName"
							   placeholder="Doe"
							   autocomplete="family-name" />
						<span asp-validation-for="LastName"></span>
					</div>

					<div class="col-sm-6">
						<label class="mf-form-label" asp-for="DateOfBirth">Date of Birth <span class="text-danger">*</span></label>
						<div class="mf-input-wrapper mf-input-has-icon-right">
							<input type="date"
								   class="mf-form-control"
								   asp-for="DateOfBirth"
								   autocomplete="bday" />
							<span class="mf-input-icon-btn pe-none" aria-hidden="true">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
									<line x1="16" y1="2" x2="16" y2="6"></line>
									<line x1="8" y1="2" x2="8" y2="6"></line>
									<line x1="3" y1="10" x2="21" y2="10"></line>
								</svg>
							</span>
						</div>
						<span asp-validation-for="DateOfBirth"></span>
					</div>

					<div class="col-sm-6">
						<label class="mf-form-label" asp-for="NationalId">National ID <span class="text-danger">*</span></label>
						<input type="text"
							   class="mf-form-control"
							   asp-for="NationalId"
							   placeholder="29901011234567"
							   autocomplete="off" />
						<span asp-validation-for="NationalId"></span>
					</div>
				</div>
			</div>

			<div class="mf-register-section">
				<h2 class="mf-register-section-title">Contact Information</h2>

				<div class="row g-3">
					<div class="col-12">
						<label class="mf-form-label" asp-for="Email">Email Address</label>
						<div class="mf-input-wrapper mf-input-has-icon-left">
							<span class="mf-input-icon-left" aria-hidden="true">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
									<polyline points="22,6 12,13 2,6"></polyline>
								</svg>
							</span>
							<input type="email"
								   class="mf-form-control"
								   value="@Model.Email"
								   readonly
								   tabindex="-1" />
						</div>
					</div>

					<div class="col-12">
						<label class="mf-form-label" asp-for="Address">Residential Address <span class="text-danger">*</span></label>
						<div class="mf-input-wrapper mf-input-has-icon-left">
							<span class="mf-input-icon-left" aria-hidden="true">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
									<polyline points="9 22 9 12 15 12 15 22"></polyline>
								</svg>
							</span>
							<input type="text"
								   class="mf-form-control"
								   asp-for="Address"
								   placeholder="123 Financial Way"
								   autocomplete="street-address" />
						</div>
						<span asp-validation-for="Address"></span>
					</div>
				</div>
			</div>

			<button type="submit" class="btn mf-btn-primary mf-btn-auth-submit" id="btn-external-register-submit">
				<span>Complete Account</span>
			</button>

			<div class="mf-auth-switch-link">
				<span>Want to use a different account?</span>
				<a asp-controller="Auth" asp-action="Login" id="link-goto-login">Back to login</a>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
