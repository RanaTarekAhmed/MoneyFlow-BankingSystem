@model MoneyFlow.Business.ViewModels.Accounts.MyAccountsVM

@{
	Layout = "_CustomerLayout";
	ViewData["Title"] = "My Accounts";
}
<h1>To be modified to account home page view</h1>

<!-- Page Header -->
<div class="mf-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
	<div>
		<h1 class="mf-page-greeting">My Accounts</h1>
		<p class="mf-page-subtitle">Manage your balances, account details, and active bank accounts.</p>
	</div>
	<div>
		<a href="/Customer/Transfer" class="btn mf-btn-primary" id="btn-accounts-transfer-money">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M17 1l4 4-4 4" />
				<path d="M3 11V9a4 4 0 0 1 4-4h14" />
			</svg>
			<span>Transfer Funds</span>
		</a>
	</div>
</div>

<!-- Account Summary Row -->
<div class="row g-4 mb-4">
	<div class="col-12 col-md-4">
		<div class="mf-card mf-metric-card">
			<div class="mf-metric-header">
				<span class="mf-metric-header-icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="2" y="4" width="20" height="16" rx="2" />
						<line x1="2" y1="10" x2="22" y2="10" />
					</svg>
				</span>
				<span>Total Liquid Balance</span>
			</div>
			<div class="mf-metric-value-wrap">
				<span class="mf-metric-value">  $@Model.Accounts.Sum(a => a.Balance).ToString("N2")</span>
			</div>
			<p class="mf-metric-note">Combined across @Model.Accounts.Count(a => a.Status == MoneyFlow.Data.Enums.AccountStatus.Active) active accounts</p>
		</div>
	</div>

	<!-- Dynamic Accounts -->
	@foreach (var account in Model.Accounts)
	{
		<div class="col-12 col-md-4">
			<div class="mf-card mf-metric-card">

				<div class="mf-metric-header">
					<span class="mf-metric-header-icon">
						<svg width="18"
							 height="18"
							 viewBox="0 0 24 24"
							 fill="none"
							 stroke="currentColor"
							 stroke-width="2"
							 stroke-linecap="round"
							 stroke-linejoin="round">

							<rect x="2" y="5"
								  width="20"
								  height="14"
								  rx="2" />

							<line x1="2"
								  y1="10"
								  x2="22"
								  y2="10" />
						</svg>
					</span>

					<span>
						@account.AccountType Balance
					</span>
				</div>

				<div class="mf-metric-value-wrap">
					<span class="mf-metric-value">
						$@account.Balance.ToString("N2")
					</span>
				</div>

				<p class="mf-metric-note">
					@account.AccountType Account
					(@account.AccountNumber)
				</p>

			</div>
		</div>
	}

</div>

<!-- Accounts Detailed Bento Grid -->
<div class="row g-4 mb-4">
	<!-- Card 1: Checking Account -->
	@foreach (var account in Model.Accounts)
	{
		<div class="col-12 col-lg-6">
			<div class="mf-card h-100 d-flex flex-column justify-content-between p-4" id="account-card-@account.Id">
				<div>
					<div class="d-flex align-items-start justify-content-between mb-3">
						<div class="d-flex align-items-center gap-3">
							<div class="mf-account-badge-icon checking">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="2" y="5" width="20" height="14" rx="2" />
									<line x1="2" y1="10" x2="22" y2="10" />
								</svg>
							</div>
							<div>
								<h2 class="h5 fw-bold text-dark mb-0"> @account.AccountType Account</h2>
								<span class="text-muted small"> @account.AccountType Account</span>
							</div>
						</div>
						<span class="mf-status-badge active"><span class="dot"></span> @account.Status </span>
					</div>

					<div class="my-4">
						<span class="text-uppercase small fw-bold text-muted d-block mb-1">Available Balance</span>
						<div class="h2 fw-extrabold text-dark mb-1">$@account.Balance.ToString("N2")</div>
						<div class="text-muted small">Account Number: <span class="fw-semibold text-dark"> @account.AccountNumber</span></div>
					</div>

					<div class="p-3 bg-light rounded-3 mb-4">
						<div class="d-flex justify-content-between text-muted small py-1">
							<span>Account Type</span>
							<span class="fw-semibold text-dark"> @account.AccountType</span>
						</div>
						<div class="d-flex justify-content-between text-muted small py-1">
							<span>Open Date</span>
							<span class="fw-semibold text-dark">@account.OpenDate.ToString("MMMM dd, yyyy")</span>
						</div>
						<div class="d-flex justify-content-between text-muted small py-1">
							<span>Currency</span>
							<span class="fw-semibold text-dark">USD ($)</span>
						</div>
					</div>
				</div>

				<div class="d-flex flex-wrap gap-2 pt-3 border-top">
					<a href="@Url.Action("AccountDetails", "Account", new { id = account.Id })"
					   class="d-flex justify-content-center align-items-center btn btn-sm btn-outline-secondary flex-grow-1"
					   id="btn-details-@account.Id">
						View Details
					</a>
					<a href="@Url.Action("Index", "Transaction", new { accountId = account.Id })"
					   class="d-flex justify-content-center align-items-center btn btn-sm btn-outline-secondary flex-grow-1"
					   id="btn-history-@account.Id">
						History
					</a>
					<a href="@Url.Action("Transfer", "Customer", new { fromAccountId = account.Id })"
					   class="btn btn-sm mf-btn-primary flex-grow-1" id="btn-transfer-@account.Id">
						Transfer
					</a>
				</div>
			</div>
		</div>
	}

	

</div>


<form asp-controller="Auth"
      asp-action="Logout"
      method="post"
      onsubmit="return confirm('Are you sure you want to log out?');">

    <button type="submit" class="btn btn-danger">
        Log out
    </button>

</form>