@{
	Layout = "_EmployeeLayout";
	ViewData["Title"] = "Account Details";
}

@model EmployeeAccountDetailsVM

<!-- Back Navigation -->
<div class="mb-3">
	<a asp-action="EmployeeIndex" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
		Back to Accounts Ledger
	</a>
</div>

<!-- Account Master Hero Card -->
<div class="mf-card mb-4">
	<div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
		<div>
			<div class="d-flex align-items-center gap-2">
				<span class="mf-txn-code fs-5 fw-bold text-dark">@Model.AccountNumber</span>
				<span class="badge bg-success-subtle text-success fw-bold">@Model.Status</span>
				<span class="badge bg-light text-dark border">@Model.AccountType Account</span>
			</div>
			<div class="text-muted small mt-1">
				Opened @Model.OpenDate.ToString("dd MMM yyyy")
			</div>
		</div>

		<div class="d-flex flex-wrap align-items-center gap-2">
			<a asp-controller="Account"
			   asp-action="Operations"
			   asp-route-accountNumber="@Model.AccountNumber"
			   class="mf-teller-btn mf-teller-btn-primary">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="12" y1="5" x2="12" y2="19"></line>
					<line x1="5" y1="12" x2="19" y2="12"></line>
				</svg>
				<span>Deposit / Withdraw</span>
			</a>
		</div>
	</div>

	<!-- Financial Breakdown Grid -->
	<div class="row g-3 mt-3 pt-3 border-top">
		<div class="col-12 col-sm-6 col-md-4">
			<span class="text-muted small text-uppercase fw-bold">Available Balance</span>
			<div class="fs-4 fw-bold text-dark">$@Model.Balance.ToString("N2")</div>
		</div>
		<div class="col-12 col-sm-6 col-md-4">
			<span class="text-muted small text-uppercase fw-bold">Account Status</span>
			@if (Model.Status == AccountStatus.Active)
			{
				<div><span class="badge bg-success-subtle text-success fs-6 fw-bold">Active</span></div>
			}
			else if (Model.Status == AccountStatus.Suspended)
			{
				<div><span class="badge bg-warning-subtle text-warning-emphasis fs-6 fw-bold">Suspended</span></div>
			}
			else
			{
				<div><span class="badge bg-danger-subtle text-danger fs-6 fw-bold">Closed</span></div>
			}
		</div>
		<div class="col-12 col-sm-6 col-md-4">
			<span class="text-muted small text-uppercase fw-bold">Account Holder</span>
			<div>
				<a asp-controller="Employee" asp-action="CustomerOverview" asp-route-id="@Model.CustomerId" class="fw-bold text-primary text-decoration-none">
					@Model.CustomerName
				</a>
				<div class="small text-muted">ID: CUST-@Model.CustomerId</div>
			</div>
		</div>
	</div>
</div>

<!-- Account Specific Transaction History -->
<div class="mf-table-card">
	<div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-light">
		<h2 class="h6 mb-0 fw-bold text-dark">Recent Activity</h2>
		<div class="d-flex align-items-center gap-2">
			<a asp-controller="Transaction" asp-action="EmployeeIndex" asp-route-Search="@Model.AccountNumber" class="text-decoration-none small text-primary fw-semibold ms-2">
				View in Ledger &rarr;
			</a>
		</div>
	</div>
	<div class="table-responsive">
		<table class="table mf-table mb-0">
			<thead>
				<tr>
					<th>Date &amp; Time</th>
					<th>Reference</th>
					<th>Description</th>
					<th>Type</th>
					<th class="text-end">Amount</th>
					<th class="text-center">Status</th>
				</tr>
			</thead>
			<tbody>
				@if (Model.RecentTransactions != null && Model.RecentTransactions.Any())
				{
					for (var i = 0; i < Model.RecentTransactions.Count; i++)
					{
						var transaction = Model.RecentTransactions[i];
						<tr class="transaction-row @(i >= 5 ? "d-none" : "")">
							<td>@transaction.TransactionDate.ToString("MMM dd, yyyy, hh:mm tt")</td>
							<td><span class="mf-txn-code">@transaction.TransactionNumber</span></td>
							<td>@transaction.Description</td>
							@if (transaction.TransactionType == TransactionType.Deposit)
							{
								<td><span class="badge bg-success-subtle text-success">Deposit</span></td>
							}
							else if (transaction.TransactionType == TransactionType.Withdrawal)
							{
								<td><span class="badge bg-secondary-subtle text-dark">Withdrawal</span></td>
							}
							else
							{
								<td><span class="badge bg-info-subtle text-primary">Transfer</span></td>
							}
							<td class="text-end fw-bold @(transaction.IsIncoming ? "text-success" : "text-navy")">
								@(transaction.IsIncoming ? "+" : "-")$@transaction.Amount.ToString("N2")
							</td>
							@if (transaction.Status == TransactionStatus.Completed)
							{
								<td class="text-center"><span class="badge bg-success text-white">Completed</span></td>
							}
							else if (transaction.Status == TransactionStatus.Pending)
							{
								<td class="text-center"><span class="badge bg-warning-subtle text-warning-emphasis fw-bold">Pending</span></td>
							}
							else
							{
								<td class="text-center"><span class="badge bg-danger-subtle text-danger fw-bold">@transaction.Status.ToString()</span></td>
							}
						</tr>
					}
				}
				else
				{
					<tr>
						<td colspan="6" class="text-center text-muted py-4">
							No recent transactions found for this account.
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	@if (Model.RecentTransactions != null && Model.RecentTransactions.Count > 5)
	{
		<div class="p-3 text-center border-top bg-light">
			<button type="button" id="toggleTransactions" class="btn btn-outline-primary btn-sm fw-semibold px-4">
				See More
			</button>
		</div>
	}
</div>
