@{
	Layout = "_EmployeeLayout";
	ViewData["Title"] = "Accounts Ledger";
}

@model EmployeeAccountIndexVM

<!-- Page Header -->
<div class="mf-page-header d-flex flex-wrap align-items-center justify-content-between gap-3">
	<div>
		<h1 class="mf-page-greeting">Global Accounts Ledger</h1>
		<p class="mf-page-subtitle">Monitor bank accounts, issue new accounts, manage account status, and inspect balances.</p>
	</div>
	<div class="d-flex align-items-center gap-2">
		<button type="button" class="mf-teller-btn mf-teller-btn-primary" data-bs-toggle="modal" data-bs-target="#openAccountForCustomerModal" id="btnOpenAccModalLedger">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<rect x="2" y="5" width="20" height="14" rx="2"></rect>
				<line x1="2" y1="10" x2="22" y2="10"></line>
			</svg>
			<span>+ Open New Customer Account</span>
		</button>
		<a href="/Employee/Operations" class="mf-teller-btn mf-teller-btn-outline">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
			<span>Teller Desk Ops</span>
		</a>
	</div>
</div>

<!-- Ledger Summary Metric Chips -->
<div class="row g-3 mb-4">
	<div class="col-12 col-sm-6 col-md-3">
		<div class="mf-kpi-card">
			<div class="mf-kpi-top">
				<span class="mf-kpi-label">Total Deposits Held</span>
				<span class="mf-kpi-icon primary">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
				</span>
			</div>
			<div class="mf-kpi-value">$@Model.Summary.TotalDepositsHeld.ToString("N0")</div>
			<span class="small text-muted">
				Across @(Model.Summary.ActiveCurrentAccounts + Model.Summary.ActiveSavingsAccounts + Model.Summary.SuspendedAccounts) accounts
			</span>
		</div>
	</div>
	<div class="col-12 col-sm-6 col-md-3">
		<div class="mf-kpi-card">
			<div class="mf-kpi-top">
				<span class="mf-kpi-label">Active Current Accounts</span>
				<span class="mf-kpi-icon success">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
				</span>
			</div>
			<div class="mf-kpi-value">@Model.Summary.ActiveCurrentAccounts Accts</div>
			<span class="small text-muted">Active standing</span>
		</div>
	</div>
	<div class="col-12 col-sm-6 col-md-3">
		<div class="mf-kpi-card">
			<div class="mf-kpi-top">
				<span class="mf-kpi-label">Active Savings Accounts</span>
				<span class="mf-kpi-icon purple">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
				</span>
			</div>
			<div class="mf-kpi-value">@Model.Summary.ActiveSavingsAccounts Accts</div>
			<span class="small text-muted">Active standing</span>
		</div>
	</div>
	<div class="col-12 col-sm-6 col-md-3">
		<div class="mf-kpi-card">
			<div class="mf-kpi-top">
				<span class="mf-kpi-label">Suspended Accounts</span>
				<span class="mf-kpi-icon warning">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
				</span>
			</div>
			<div class="mf-kpi-value">@Model.Summary.SuspendedAccounts Accounts</div>
			<span class="small text-warning-emphasis">Transactions blocked</span>
		</div>
	</div>
</div>

<!-- Filters Bar Card -->
<div class="mf-filter-card">
	<div class="row g-3 align-items-center">
		<!-- Live Search -->
		<div class="col-12 col-md-5">
			<div class="mf-search-input-wrap">
				<span class="mf-search-icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="11" cy="11" r="8"/>
						<line x1="21" y1="21" x2="16.65" y2="16.65"/>
					</svg>
				</span>
				<input type="text" class="form-control mf-form-control" id="empAccountSearch" placeholder="Search by Account #, Customer name..." />
			</div>
		</div>

		<!-- Account Type Filter strictly following AccountType Enum -->
		<div class="col-6 col-md-3">
			<select class="form-select mf-form-control" id="empAccountTypeFilter">
				<option value="">All Account Types</option>
				<option value="Current">Current</option>
				<option value="Savings">Savings</option>
			</select>
		</div>

		<!-- Account Status Filter strictly following AccountStatus Enum -->
		<div class="col-6 col-md-3">
			<select class="form-select mf-form-control" id="empAccountStatusFilter">
				<option value="">All Statuses</option>
				<option value="Active">Active</option>
				<option value="Suspended">Suspended</option>
				<option value="Closed">Closed</option>
			</select>
		</div>

		<!-- Reset Button -->
		<div class="col-12 col-md-1 d-flex justify-content-end">
			<button type="button" class="btn btn-outline-secondary w-100 p-2" id="btnClearempAccountSearch" title="Clear all filters">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="1 4 1 10 7 10"/>
					<path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
				</svg>
			</button>
		</div>
	</div>
</div>

<!-- Global Accounts Table -->
<div class="mf-table-card">
	@if (Model.Accounts.Items.Any())
	{
		<div class="table-responsive">
			<table class="table mf-table">
				<thead>
					<tr>
						<th scope="col">Account Number</th>
						<th scope="col">Account Holder</th>
						<th scope="col">Type</th>
						<th scope="col" class="text-end">Current Balance</th>
						<th scope="col" class="text-center">Status</th>
						<th scope="col" class="text-end">Actions</th>
					</tr>
				</thead>
				<tbody id="empAccountTableBody">
					@foreach (var account in Model.Accounts.Items)
					{
						<tr data-filter-item="true" data-type="Current" data-status="Active">
							<td>
								<span class="mf-txn-code fs-6 fw-bold">@account.AccountNumber</span>
								<div class="small text-muted">Opened @account.OpenDate.ToString("dd MMM yyyy")</div>
							</td>
							<td>
								<a href="/Employee/CustomerDetails" class="fw-bold text-dark text-decoration-none">@account.CustomerName</a>
								<div class="small text-muted">@account.CustomerEmail</div>
							</td>
							<td>
								<span class="badge bg-light text-dark border">@account.AccountType</span>
							</td>
							<td class="text-end">
								<div class="fw-bold text-dark fs-6">$@account.Balance.ToString("N2")</div>
							</td>
							<td class="text-center">
								@if (account.Status == AccountStatus.Active)
								{
									<span class="badge bg-success-subtle text-success fw-bold px-2 py-1">Active</span>
								}
								else if (account.Status == AccountStatus.Suspended)
								{
									<span class="badge bg-warning-subtle text-warning-emphasis fw-bold px-2 py-1">Suspended</span>
								}
								else
								{
									<span class="badge bg-danger-subtle text-danger fw-bold px-2 py-1">Closed</span>
								}
							</td>
							<td class="text-end">
								<div class="dropdown">
									<button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">Manage</button>
									<ul class="dropdown-menu dropdown-menu-end">
										<li><a class="dropdown-item" href="/Account/EmployeeDetails">View Account Details</a></li>
										<li><a class="dropdown-item" href="/Employee/Operations">Deposit / Withdraw</a></li>
										<li><hr class="dropdown-divider"></li>
										<li><a class="dropdown-item text-danger" href="javascript:void(0);" data-bs-toggle="modal" data-bs-target="#freezeAccountModal">Update Status</a></li>
									</ul>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		var startPage = Math.Max(1, Model.Accounts.PageNumber - 1);
		var endPage = Math.Min(Model.Accounts.TotalPages, startPage + 2);

		if (endPage - startPage < 2)
		{
			startPage = Math.Max(1, endPage - 2);
		}

		var startItem = Model.Accounts.TotalCount == 0
		? 0
		: (Model.Accounts.PageNumber - 1) * Model.Accounts.PageSize + 1;
		var endItem = Math.Min(
			Model.Accounts.TotalCount,
			Model.Accounts.PageNumber * Model.Accounts.PageSize
		);

		<!-- Responsive Pagination Footer -->
		<div class="p-3 border-top d-flex flex-wrap align-items-center justify-content-between gap-3 bg-light" id="accountPagination">
			<div class="text-muted small">
				Showing <strong class="text-dark">@startItem</strong> to <strong class="text-dark">@endItem</strong> of <strong class="text-dark">@Model.Accounts.TotalCount</strong> accounts
			</div>
			<nav aria-label="Accounts Ledger Pagination">
				<ul class="pagination pagination-sm mb-0">
					@if (Model.Accounts.HasPrevious)
					{
						<li class="page-item">
							<a class="page-link"
							   asp-action="EmployeeIndex"
							   asp-route-page="@(Model.Accounts.PageNumber - 1)"
							   asp-route-Search="@Model?.Query?.Search"
							   asp-route-AccountType="@Model?.Query?.AccountType"
							   asp-route-Status="@Model?.Query?.Status"
							   tabindex="-1"
							   aria-disabled="true">
								Previous
							</a>
						</li>
					}
					else
					{
						<li class="page-item disabled">
							<span class="page-link" tabindex="-1" aria-disabled="true">Previous</span>
						</li>
					}

					@for (int i = startPage; i <= endPage; ++i)
					{
						<li class="page-item @(i == Model?.Accounts.PageNumber ? "active" : "")" aria-current="page">
							<a class="page-link"
							   asp-action="EmployeeIndex"
							   asp-route-page="@i"
							   asp-route-Search="@Model?.Query?.Search"
							   asp-route-AccountType="@Model?.Query?.AccountType"
							   asp-route-Status="@Model?.Query?.Status">
								@i
							</a>
						</li>
					}

					@if (Model != null && Model.Accounts.HasNext)
					{
						<li class="page-item">
							<a class="page-link"
							   asp-action="EmployeeIndex"
							   asp-route-page="@(Model.Accounts.PageNumber + 1)"
							   asp-route-Search="@Model?.Query?.Search"
							   asp-route-AccountType="@Model?.Query?.AccountType"
							   asp-route-Status="@Model?.Query?.Status">
								Next
							</a>
						</li>
					}
					else
					{
						<li class="page-item disabled">
							<span class="page-link">Next</span>
						</li>
					}
				</ul>
			</nav>
		</div>
	}
	else
	{
		<!-- Empty State when no accounts found -->
		<div class="p-5 text-center" id="empTxnEmptyState">
			<div class="text-muted mb-2">
				<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="8" />
					<line x1="21" y1="21" x2="16.65" y2="16.65" />
				</svg>
			</div>
			<h3 class="h6 fw-bold text-dark mb-1">No bank accounts match your search filters.</h3>
			<p class="text-muted small">Try clearing or adjusting the account filters.</p>
		</div>
	}
</div>

<!-- Modal: Update Account Status -->
<div class="modal fade" id="freezeAccountModal" tabindex="-1" aria-labelledby="freezeAccountModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content border-0 shadow">
			<div class="modal-header bg-danger text-white">
				<h5 class="modal-title fw-bold" id="freezeAccountModalLabel">Update Account Status</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body p-4">
				<p class="mb-3 text-dark">Select the new status for account <strong class="mf-txn-code">MF-100234</strong>.</p>
				<div class="mb-3">
					<label class="form-label fw-bold small text-dark">Target Status <span class="text-danger">*</span></label>
					<select class="form-select mf-form-control" id="accountStatusTargetSelect">
						<option value="Suspended">Suspended</option>
						<option value="Closed">Closed</option>
						<option value="Active">Active</option>
					</select>
				</div>
				<div>
					<label class="form-label fw-bold small text-dark">Staff Remarks</label>
					<textarea class="form-control mf-form-control" rows="2" placeholder="Specify reason for status modification..."></textarea>
				</div>
			</div>
			<div class="modal-footer bg-light">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-danger fw-bold" id="btnConfirmFreezeAccount" data-target-acct="MF-100234">Save Status</button>
			</div>
		</div>
	</div>
</div>

<!-- Modal: Open Account with Searchable Customer Select -->
