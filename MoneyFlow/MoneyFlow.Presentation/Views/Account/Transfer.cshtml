@model MoneyFlow.Business.ViewModels.Accounts.TransferVM

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Transfer Money";

    bool transferSuccessful = ViewBag.TransferSuccessful == true;
    string? transactionNumber = ViewBag.TransactionNumber as string;
    DateTime? transactionDate = ViewBag.TransactionDate;
}

<div class="mf-page-header">
    <h1 class="mf-page-greeting">Transfer Money</h1>
    <p class="mf-page-subtitle">
        Securely move funds between your accounts or to external recipients with instant settlement.
    </p>
</div>

@if (!transferSuccessful)
{
    <!-- TRANSFER FORM -->
    <div class="row g-4" id="transferFormContainer">
        <div class="col-12 col-lg-8">
            <div class="mf-card p-4 p-md-5">
                <form asp-controller="Account" asp-action="Transfer" method="post" id="mfTransferForm">
                    @Html.AntiForgeryToken()

                    <!-- Validation Summary for Errors (Displays error messages if recipient doesn't exist or balance is low) -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                    <!-- STEP 1: Account Details -->
                    <div class="mb-5">
                        <div class="d-flex align-items-center gap-2 mb-4">
                            <span class="mf-step-num">1</span>
                            <h2 class="h5 fw-bold text-dark mb-0">Account Details</h2>
                        </div>

                        <div class="row g-3">
                            <!-- Sender Account -->
                            <div class="col-12">
                                <label asp-for="SenderAccountId" class="mf-form-label">From Account</label>
                                <select asp-for="SenderAccountId" class="form-select mf-form-control" id="fromAccountSelect">
                                    <option value="">-- Select Your Account --</option>
                                    @if (Model.Accounts != null)
                                    {
                                        foreach (var account in Model.Accounts)
                                        {
                                            <option value="@account.Id" 
                                                    data-account-number="@account.AccountNumber" 
                                                    data-balance="@account.Balance">
                                                @account.AccountNumber &mdash; Balance: @account.Balance.ToString("N2")
                                            </option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="SenderAccountId" class="text-danger"></span>
                            </div>

                            <!-- Receiver Account -->
                            <div class="col-12">
                                <label asp-for="ReceiverAccountNumber" class="mf-form-label">To Account / Recipient</label>
                                <input asp-for="ReceiverAccountNumber" 
                                       class="form-control mf-form-control" 
                                       id="toAccountInput" 
                                       placeholder="Enter receiver account number" 
                                       autocomplete="off" />
                                <span asp-validation-for="ReceiverAccountNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4 text-muted" />

                    <!-- STEP 2: Transfer Amount -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-4">
                            <span class="mf-step-num">2</span>
                            <h2 class="h5 fw-bold text-dark mb-0">Transfer Amount</h2>
                        </div>

                        <!-- Amount Input -->
                        <div class="mb-4">
                            <label asp-for="Amount" class="mf-form-label">Amount</label>
                            <div class="mf-amount-hero-input">
                                <span class="mf-amount-currency">$</span>
                                <input asp-for="Amount" 
                                       type="number" 
                                       step="0.01" 
                                       min="5.00" 
                                       class="form-control mf-amount-input" 
                                       id="transferAmountInput" 
                                       placeholder="5.00" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger"></span>

                            <!-- Available Balance Display -->
                            <div class="mt-2">
                                <span class="small text-muted">
                                    Available balance: <strong class="text-dark" id="availableBalance">Select an account</strong>
                                </span>
                            </div>

                            <!-- Quick Amount Chips -->
                            <div class="mf-quick-chips mt-3">
                                <button type="button" class="mf-chip-btn" data-amount="50">+$50</button>
                                <button type="button" class="mf-chip-btn" data-amount="100">+$100</button>
                                <button type="button" class="mf-chip-btn" data-amount="500">+$500</button>
                                <button type="button" class="mf-chip-btn" data-amount="1000">+$1,000</button>
                                <button type="button" class="mf-chip-btn" id="maxAmountButton">Max</button>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label asp-for="Description" class="mf-form-label">
                                Description <span class="fw-normal text-muted">(Optional)</span>
                            </label>
                            <textarea asp-for="Description" 
                                      class="form-control mf-form-control" 
                                      id="transferDescriptionInput" 
                                      rows="3" 
                                      placeholder="What is this transfer for?"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                        <a asp-controller="Account" asp-action="Index" class="btn btn-light px-4 py-2 fw-semibold">Cancel</a>
                        <button type="button" class="btn mf-btn-primary px-4 py-2" id="btnReviewTransfer">
                            Review Transfer
                            <svg class="mf-btn-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12h14M12 5l7 7-7 7" />
                            </svg>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sidebar Information -->
        <div class="col-12 col-lg-4">
            <div class="mf-card mb-4" style="border-left: 4px solid var(--mf-success);">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="text-success">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        </svg>
                    </span>
                    <h3 class="h6 fw-bold mb-0 text-dark">Security Tip</h3>
                </div>
                <p class="text-muted small mb-0">
                    Always double-check the receiver account number before sending funds. Transfers are processed immediately.
                </p>
            </div>

            <div class="mf-card">
                <h3 class="h6 fw-bold text-dark text-uppercase mb-3">Transfer Information</h3>
                <div class="small text-muted">
                    <p class="mb-2"><strong class="text-dark">Sender:</strong> Select one of your accounts.</p>
                    <p class="mb-2"><strong class="text-dark">Receiver:</strong> Enter the receiver's account number.</p>
                    <p class="mb-0"><strong class="text-dark">Settlement:</strong> Transfers are processed immediately.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- REVIEW MODAL -->
    <div class="modal fade" id="transferReviewModal" tabindex="-1" aria-labelledby="transferReviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header">
                    <h2 class="modal-title h5 fw-bold" id="transferReviewModalLabel">Review Transfer Details</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Please review the details before confirming.</p>
                    <div class="bg-light p-3 rounded-3">
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">From Account</span>
                            <strong id="revFromAccount">-</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">To Account</span>
                            <strong id="revToAccount">-</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Amount</span>
                            <strong id="revAmount">$0.00</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Transfer Fee</span>
                            <strong class="text-success">$0.00</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Total Debit</span>
                            <strong id="revTotal">$0.00</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Description</span>
                            <strong id="revDescription">None</strong>
                        </div>
                    </div>
                    <div class="alert alert-info mt-3 mb-0 small">
                        Transfers are processed immediately and cannot be cancelled after confirmation.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Make Changes</button>
                    <button type="button" class="btn mf-btn-primary" id="btnConfirmTransfer">Confirm &amp; Send Funds</button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- TRANSFER SUCCESS RECEIPT -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <div class="mf-receipt-card" id="transferSuccessCard">
                <div class="mf-success-icon-badge">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                </div>

                <h2 class="h4 fw-bold text-navy mb-1">Transfer Completed!</h2>
                <p class="text-muted small mb-4">Your funds have been transferred successfully.</p>

                <div class="p-3 bg-light rounded-3 mb-4 text-start">
                    <div class="mf-receipt-item-row">
                        <span class="mf-receipt-item-label">Amount Transferred</span>
                        <span class="mf-receipt-item-value fs-5 text-success" id="receiptAmount">@Model.Amount.ToString("C")</span>
                    </div>
                    <div class="mf-receipt-item-row">
                        <span class="mf-receipt-item-label">Recipient Account</span>
                        <span class="mf-receipt-item-value" id="receiptTo">@Model.ReceiverAccountNumber</span>
                    </div>
                    <div class="mf-receipt-item-row">
                        <span class="mf-receipt-item-label">Transaction Number</span>
                        <span class="mf-receipt-item-value font-monospace" id="receiptTxnNumber">@(transactionNumber ?? "N/A")</span>
                    </div>
                    <div class="mf-receipt-item-row">
                        <span class="mf-receipt-item-label">Timestamp</span>
                        <span class="mf-receipt-item-value" id="receiptTime">
                            @(transactionDate.HasValue ? transactionDate.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") : "Just now")
                        </span>
                    </div>
                    <div class="mf-receipt-item-row">
                        <span class="mf-receipt-item-label">Transfer Fee</span>
                        <span class="mf-receipt-item-value text-success">$0.00 (Free)</span>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <a asp-controller="Account" asp-action="Transfer" class="btn btn-outline-secondary" id="btnNewTransfer">Make Another Transfer</a>
                    <a asp-controller="Transaction" asp-action="CustomerIndex" class="btn mf-btn-primary">View in Transactions</a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("mfTransferForm");
            if (!form) return;

            const senderSelect = document.getElementById("fromAccountSelect");
            const receiverInput = document.getElementById("toAccountInput");
            const amountInput = document.getElementById("transferAmountInput");
            const descriptionInput = document.getElementById("transferDescriptionInput");
            const availableBalance = document.getElementById("availableBalance");
            const reviewButton = document.getElementById("btnReviewTransfer");
            const confirmButton = document.getElementById("btnConfirmTransfer");
            const reviewModalElement = document.getElementById("transferReviewModal");

            // Element error message spans
            const senderValidationSpan = document.querySelector('[data-valmsg-for="SenderAccountId"]');
            const receiverValidationSpan = document.querySelector('[data-valmsg-for="ReceiverAccountNumber"]');
            const amountValidationSpan = document.querySelector('[data-valmsg-for="Amount"]');

            const formatCurrency = (val) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(val);

            // Clear custom error message helper
            const clearError = (span) => {
                if (span) {
                    span.textContent = "";
                    span.className = "text-danger field-validation-valid";
                }
            };

            // Display custom error message helper
            const showError = (span, message) => {
                if (span) {
                    span.textContent = message;
                    span.className = "text-danger field-validation-error";
                }
            };

            // Sender account selection event
            senderSelect.addEventListener("change", function () {
                clearError(senderValidationSpan);
                const selectedOption = senderSelect.options[senderSelect.selectedIndex];
                if (!selectedOption || !selectedOption.value || !selectedOption.dataset.balance) {
                    availableBalance.textContent = "Select an account";
                    amountInput.removeAttribute("max");
                    return;
                }

                const balance = parseFloat(selectedOption.dataset.balance);
                availableBalance.textContent = formatCurrency(balance);
                amountInput.max = balance.toFixed(2);
            });

            // Quick amount buttons
            document.querySelectorAll(".mf-chip-btn").forEach(function (button) {
                button.addEventListener("click", function () {
                    clearError(amountValidationSpan);
                    const selectedOption = senderSelect.options[senderSelect.selectedIndex];
                    const balance = selectedOption && selectedOption.dataset.balance ? parseFloat(selectedOption.dataset.balance) : 0;

                    let targetAmount = 0;
                    if (button.id === "maxAmountButton") {
                        targetAmount = balance;
                    } else {
                        const chipVal = parseFloat(button.dataset.amount);
                        const currentVal = parseFloat(amountInput.value) || 0;
                        targetAmount = currentVal + chipVal;
                    }

                    if (!isNaN(targetAmount) && targetAmount > 0) {
                        amountInput.value = targetAmount.toFixed(2);
                    }
                });
            });

            // Input field error clearing on type
            receiverInput.addEventListener("input", () => clearError(receiverValidationSpan));
            amountInput.addEventListener("input", () => clearError(amountValidationSpan));

            // Review Transfer Button Click
            reviewButton.addEventListener("click", function () {
                let hasError = false;

                // Reset inline validation messages
                clearError(senderValidationSpan);
                clearError(receiverValidationSpan);
                clearError(amountValidationSpan);

                // 1. Standard HTML5 / jQuery Validation Check
                if (typeof $(form).valid === "function") {
                    if (!$(form).valid()) hasError = true;
                } else if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }

                // 2. Validate Sender Selected
                const selectedOption = senderSelect.options[senderSelect.selectedIndex];
                if (!senderSelect.value || !selectedOption) {
                    showError(senderValidationSpan, "Please select a sender account.");
                    hasError = true;
                }

                // 3. Validate Receiver Account Number Entered
                const receiverAccountNum = receiverInput.value.trim();
                if (!receiverAccountNum) {
                    showError(receiverValidationSpan, "Please enter the receiver account number.");
                    hasError = true;
                }

                // 4. Validate Same Account Transfer
                const senderAccountNum = selectedOption ? selectedOption.dataset.accountNumber : "";
                if (senderAccountNum && receiverAccountNum && senderAccountNum === receiverAccountNum) {
                    showError(receiverValidationSpan, "You cannot transfer money to the same account.");
                    hasError = true;
                }

                // 5. Validate Amount Rules (Minimum $5.00 & Balance Check)
                const amount = parseFloat(amountInput.value) || 0;
                const balance = selectedOption && selectedOption.dataset.balance ? parseFloat(selectedOption.dataset.balance) : 0;

                if (amount < 5.00) {
                    showError(amountValidationSpan, "The minimum transfer amount is $5.00.");
                    hasError = true;
                } else if (amount > balance) {
                    showError(amountValidationSpan, "Transfer amount exceeds your available balance.");
                    hasError = true;
                }

                // Stop execution if any validation rule failed
                if (hasError) return;

                // 6. All Client Validations Passed — Populate and Open Review Modal
                const description = descriptionInput.value.trim();

                document.getElementById("revFromAccount").textContent = senderAccountNum || selectedOption.textContent.trim();
                document.getElementById("revToAccount").textContent = receiverAccountNum;
                document.getElementById("revAmount").textContent = formatCurrency(amount);
                document.getElementById("revTotal").textContent = formatCurrency(amount);
                document.getElementById("revDescription").textContent = description || "None";

                const modal = bootstrap.Modal.getOrCreateInstance(reviewModalElement);
                modal.show();
            });

            // Confirm Transfer Button Submit
            confirmButton.addEventListener("click", function () {
                confirmButton.disabled = true;
                confirmButton.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status"></span>Processing...`;
                form.submit();
            });
        });
    </script>
}