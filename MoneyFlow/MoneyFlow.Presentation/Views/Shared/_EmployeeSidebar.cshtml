@* MoneyFlow Employee Portal - Responsive Sidebar Partial *@
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}

<aside class="mf-portal-sidebar" id="mfEmployeeSidebar">
    <!-- Sidebar Brand -->
    <a href="/Employee/Index" class="mf-sidebar-brand" id="portal-brand-link">
        <span class="mf-sidebar-brand-icon" aria-hidden="true" style="background: linear-gradient(135deg, #002d62 0%, #00193c 100%);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L2 8.5H22L12 2Z" />
                <rect x="4.25" y="10.5" width="3" height="8.5" rx="1.5" />
                <rect x="10.5" y="10.5" width="3" height="8.5" rx="1.5" />
                <rect x="16.75" y="10.5" width="3" height="8.5" rx="1.5" />
                <rect x="2" y="21" width="20" height="2" rx="1" />
            </svg>
        </span>
        <div class="mf-sidebar-brand-text">
            <span class="mf-sidebar-brand-title">MoneyFlow</span>
            <span class="mf-sidebar-brand-subtitle text-primary fw-bold" style="font-size: 0.65rem; letter-spacing: 0.05em;">STAFF PORTAL</span>
        </div>
    </a>

    <!-- Staff Identity Pill in Sidebar -->
    <a href="/Employee/Profile" class="text-decoration-none d-block">
        <div class="mf-employee-badge-container">
            <div class="mf-employee-avatar-sm">ST</div>
            <div class="mf-employee-meta">
                <div class="mf-employee-name">Staff Officer</div>
                <div class="mf-employee-role">Senior Bank Teller</div>
            </div>
        </div>
    </a>

    <!-- Sidebar Navigation -->
    <nav class="mf-sidebar-nav" aria-label="Employee Portal Navigation">
        <div class="mf-sidebar-section-title">Overview & Operations</div>
        
        <a href="/Employee/Index" class="mf-nav-item @(currentAction == "Index" ? "active" : "")" id="emp-nav-dashboard">
            <span class="mf-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1"/>
                    <rect x="14" y="3" width="7" height="7" rx="1"/>
                    <rect x="14" y="14" width="7" height="7" rx="1"/>
                    <rect x="3" y="14" width="7" height="7" rx="1"/>
                </svg>
            </span>
            <span>Dashboard</span>
        </a>

        <a href="/Employee/Operations" class="mf-nav-item @(currentAction == "Operations" ? "active" : "")" id="emp-nav-operations">
            <span class="mf-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"/>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
            </span>
            <span>Teller Cash Ops</span>
            <span class="badge bg-success ms-auto rounded-pill px-2 py-1" style="font-size: 0.65rem;">Fast Desk</span>
        </a>

        <div class="mf-sidebar-section-title mt-3">Banking Management</div>

        <a href="/Employee/Customers" class="mf-nav-item @(currentAction == "Customers" || currentAction == "CustomerDetails" ? "active" : "")" id="emp-nav-customers">
            <span class="mf-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </span>
            <span>Customers</span>
        </a>

        <a href="/Employee/Accounts" class="mf-nav-item @(currentAction == "Accounts" || currentAction == "AccountDetails" ? "active" : "")" id="emp-nav-accounts">
            <span class="mf-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="5" width="20" height="14" rx="2"/>
                    <line x1="2" y1="10" x2="22" y2="10"/>
                </svg>
            </span>
            <span>Accounts Ledger</span>
        </a>

        <a href="/Transaction/EmployeeIndex" class="mf-nav-item @(currentAction == "Transactions" ? "active" : "")" id="emp-nav-transactions">
            <span class="mf-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                </svg>
            </span>
            <span>Transactions</span>
        </a>

        <div class="mf-sidebar-section-title mt-3">Staff Tools</div>

        <a href="/Employee/Profile" class="mf-nav-item @(currentAction == "Profile" ? "active" : "")" id="emp-nav-profile">
            <span class="mf-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </span>
            <span>My Profile &amp; Security</span>
        </a>
    </nav>

    <!-- Sidebar Footer -->
    <div class="mf-sidebar-footer">
        <form asp-controller="Auth" asp-action="Logout" method="post">
            <button type="submit" class="btn w-100 border-0 mf-nav-item text-danger" id="emp-nav-item-logout">
                <span class="mf-nav-item-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <polyline points="16 17 21 12 16 7" />
                        <line x1="21" y1="12" x2="9" y2="12" />
                    </svg>
                </span>
                <span>End Shift &amp; Logout</span>
            </button>
        </form>
    </div>
</aside>

<!-- Off-canvas Backdrop for Mobile -->
<div class="mf-sidebar-backdrop" id="mfSidebarBackdrop"></div>
