@* MoneyFlow Customer Portal - Responsive Sidebar Partial *@
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}

<aside class="mf-portal-sidebar" id="mfPortalSidebar">
    <!-- Sidebar Brand -->
    <a href="/Customer/Index" class="mf-sidebar-brand" id="portal-brand-link">
        <span class="mf-sidebar-brand-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L2 8.5H22L12 2Z" />
                <rect x="4.25" y="10.5" width="3" height="8.5" rx="1.5" />
                <rect x="10.5" y="10.5" width="3" height="8.5" rx="1.5" />
                <rect x="16.75" y="10.5" width="3" height="8.5" rx="1.5" />
                <rect x="2" y="21" width="20" height="2" rx="1" />
            </svg>
        </span>
        <div class="mf-sidebar-brand-text">
            <span class="mf-sidebar-brand-title">MoneyFlow</span>
            <span class="mf-sidebar-brand-subtitle">Trust-First Banking</span>
        </div>
    </a>

    <!-- Sidebar Navigation -->
    <nav class="mf-sidebar-nav" aria-label="Customer Portal Navigation">
        <div class="mf-sidebar-section-title">Core Banking</div>
        
        <a href="/Customer/Index" class="mf-nav-item @(currentAction == "Index" && currentController == "Customer" ? "active" : "")" id="nav-item-dashboard">
            <span class="mf-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1"/>
                    <rect x="14" y="3" width="7" height="7" rx="1"/>
                    <rect x="14" y="14" width="7" height="7" rx="1"/>
                    <rect x="3" y="14" width="7" height="7" rx="1"/>
                </svg>
            </span>
            <span>Dashboard</span>
        </a>

        <a href="/Account/Index" class="mf-nav-item @(currentController == "Account" && (currentAction == "Index" || currentAction == "AccountDetails") ? "active" : "")"  id="nav-item-accounts">
            <span class="mf-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="5" width="20" height="14" rx="2"/>
                    <line x1="2" y1="10" x2="22" y2="10"/>
                </svg>
            </span>
            <span>My Accounts</span>
        </a>

        <a href="/Customer/Transfer" class="mf-nav-item @(currentAction == "Transfer" ? "active" : "")" id="nav-item-transfer">
            <span class="mf-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 1l4 4-4 4"/>
                    <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
                    <path d="M7 23l-4-4 4-4"/>
                    <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
                </svg>
            </span>
            <span>Transfer Money</span>
        </a>

        <a asp-controller="Transaction" asp-action="Index" class="mf-nav-item @(currentController == "Transaction" && (currentAction == "Index" || currentAction == "Details") ? "active" : "")" id="nav-item-transactions">
            <span class="mf-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"/>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
            </span>
            <span>Transactions</span>
        </a>

        <div class="mf-sidebar-section-title mt-3">Account & Tools</div>

        <a href="/Customer/Notifications" class="mf-nav-item @(currentAction == "Notifications" ? "active" : "")" id="nav-item-notifications">
            <span class="mf-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
            </span>
            <span>Notifications</span>
            <span class="mf-nav-badge">2</span>
        </a>

        <a href="/Customer/Profile" class="mf-nav-item @(currentAction == "Profile" ? "active" : "")" id="nav-item-profile">
            <span class="mf-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </span>
            <span>Profile</span>
        </a>
    </nav>

    <!-- Sidebar Footer -->
    <div class="mf-sidebar-footer">
        <a href="/Customer/Settings" class="mf-nav-item @(currentAction == "Settings" ? "active" : "")" id="nav-item-settings">
            <span class="mf-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                </svg>
            </span>
            <span>Settings</span>
        </a>
        <a href="/Auth/Login" class="mf-nav-item text-danger" id="nav-item-logout">
            <span class="mf-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
            </span>
            <span>Logout</span>
        </a>
    </div>
</aside>

<!-- Off-canvas Backdrop for Mobile -->
<div class="mf-sidebar-backdrop" id="mfSidebarBackdrop"></div>
