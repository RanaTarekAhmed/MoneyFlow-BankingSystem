<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MoneyFlow Digital Banking</title>
    <meta name="description" content="MoneyFlow - Banking Made Simple, Secure, and Smarter. Institutional-grade digital finance with everyday ease." />
    
    <link rel="icon" type="image/png" href="~/favicon.png" />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- MoneyFlow Global Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    @if (ViewData["ShowNavbar"] as bool? ?? true)
    {
        @await Html.PartialAsync("_Navbar")
    }

    <main role="main" id="main-content">
        @RenderBody()
    </main>

    @if (ViewData["ShowFooter"] as bool? ?? true)
    {
        @await Html.PartialAsync("_Footer")
    }

    <!-- Bootstrap & Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
