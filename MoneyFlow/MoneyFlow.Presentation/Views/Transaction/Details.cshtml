
@{
	Layout = "_CustomerLayout";
	ViewData["Title"] = "Transaction Details";
}

@model TransactionDetailsVM

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><a href="/Transaction/Index" class="text-decoration-none">Transactions</a></li>
		<li class="breadcrumb-item active" aria-current="page">@Model.TransactionNumber</li>
	</ol>
</nav>

<!-- Page Header -->
<div class="mf-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
	<div>
		<h1 class="mf-page-greeting">Transaction @Model.TransactionNumber</h1>
		<p class="mf-page-subtitle">Processed on <span class="fw-bold text-dark">@Model.TransactionDate.ToString("MMM dd, yyyy") at @Model.TransactionDate.ToString("HH:mm")</span></p>
	</div>
	<div class="d-flex gap-2">
		<button type="button" class="btn btn-outline-secondary" onclick="window.print();" id="btn-print-receipt">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="6 9 6 2 18 2 18 9"/>
				<path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
				<rect x="6" y="14" width="12" height="8"/>
			</svg>
			<span class="ms-1">Print Receipt</span>
		</button>
	</div>
</div>

<div class="row g-4 justify-content-center">
	<div class="col-12 col-lg-8">
		<!-- Receipt Details Card -->
		<div class="mf-card p-4 p-md-5">
			<!-- Hero Amount Header -->
			<div class="text-center pb-4 mb-4 border-bottom">
				<div class="mf-txn-icon-wrap @Model.TransactionType.ToString().ToLower() mx-auto mb-3" style="width: 60px; height: 60px;">
					@if (Model.TransactionType == TransactionType.Deposit)
					{
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<line x1="12" y1="19" x2="12" y2="5" />
							<polyline points="5 12 12 5 19 12" />
						</svg>
					}
					else if (Model.TransactionType == TransactionType.Withdrawal)
					{
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<line x1="12" y1="5" x2="12" y2="19" />
							<polyline points="19 12 12 19 5 12" />
						</svg>
					}
					else
					{
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M17 1l4 4-4 4" />
							<path d="M3 11V9a4 4 0 0 1 4-4h14" />
						</svg>
					}
				</div>
				<div class="display-6 fw-extrabold @(Model.IsIncoming ? "text-success" : "text-navy") mb-1">
					@(Model.IsIncoming ? "+" : "-") $@Model.Amount
				</div>
				<div class="d-inline-flex align-items-center gap-2">
					<span class="mf-status-badge @Model.Status.ToString().ToLower()"><span class="dot"></span>@Model.Status.ToString()</span>
					<span class="text-muted small">&bull; @Model.TransactionType.ToString()</span>
				</div>
			</div>

			<!-- Transaction Metadata -->
			<div class="d-flex flex-column gap-3 mb-4">
				<div class="mf-receipt-item-row">
					<span class="mf-receipt-item-label">Transaction Number</span>
					<span class="mf-receipt-item-value font-monospace">@Model.TransactionNumber</span>
				</div>
				<div class="mf-receipt-item-row">
					<span class="mf-receipt-item-label">Transaction Type</span>
					<span class="mf-receipt-item-value">@Model.TransactionType.ToString()</span>
				</div>
				@if (Model.SenderAccount != null)
				{
					<div class="mf-receipt-item-row">
						<span class="mf-receipt-item-label">Source Account</span>
						<span class="mf-receipt-item-value">@Model.SenderAccount.AccountType.ToString() (•••• @Model.SenderAccount.AccountNumber[^4..])</span>
					</div>
				}
				@if (Model.ReceiverAccount != null)
				{
					<div class="mf-receipt-item-row">
						<span class="mf-receipt-item-label">Destination Account</span>
						<span class="mf-receipt-item-value">@Model.ReceiverAccount.AccountType.ToString() (•••• @Model.ReceiverAccount.AccountNumber[^4..])</span>
					</div>
				}
				<div class="mf-receipt-item-row">
					<span class="mf-receipt-item-label">Description</span>
					<span class="mf-receipt-item-value">@Model.Description</span>
				</div>
				<div class="mf-receipt-item-row">
					<span class="mf-receipt-item-label">Processed Date &amp; Time</span>
					<span class="mf-receipt-item-value">@Model.TransactionDate.ToString("MMM dd, yyyy"), @Model.TransactionDate.ToString("HH:mm:ss")</span>
				</div>
				<div class="mf-receipt-item-row">
					<span class="mf-receipt-item-label">Processing Fee</span>
					<span class="mf-receipt-item-value text-success">$0.00</span>
				</div>
				<div class="mf-receipt-item-row">
					<span class="mf-receipt-item-label">Total Amount Settled</span>
					<span class="mf-receipt-item-value fw-bold text-dark fs-6">$@Model.Amount</span>
				</div>
			</div>

			<!-- Transaction Audit Timeline -->
			@* <div class="p-3 bg-light rounded-3">
				<h2 class="h6 fw-bold text-dark mb-3">Status Timeline</h2>
				<div class="d-flex flex-column gap-2 small">
					<div class="d-flex align-items-center gap-2 text-success">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="20 6 9 17 4 12"/>
						</svg>
						<span><strong>Completed:</strong> Oct 24, 2023 14:32:04 EST</span>
					</div>
					<div class="d-flex align-items-center gap-2 text-muted">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"/>
						</svg>
						<span><strong>Initiated:</strong> Oct 24, 2023 14:31:50 EST</span>
					</div>
				</div>
			</div> *@

			<div class="d-flex justify-content-between align-items-center pt-4 mt-4 border-top">
				<a asp-action="Index" asp-route-page="@ViewBag.PageNumber" class="btn btn-light">&larr; Back to History</a>
				<a href="/Account/Transfer" class="btn mf-btn-primary">New Transfer</a> <!--account/transfer-->
			</div>
		</div>
	</div>
</div>
