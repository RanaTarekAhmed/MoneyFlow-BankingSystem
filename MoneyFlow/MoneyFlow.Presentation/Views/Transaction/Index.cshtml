
@{
	Layout = "_CustomerLayout";
	ViewData["Title"] = "Transactions";
}

@model TransactionIndexVM

<!-- Page Header -->
<div class="mf-page-header">
	<h1 class="mf-page-greeting">Transaction History</h1>
	<p class="mf-page-subtitle">View, search, and track all deposits, withdrawals, and account transfers.</p>
</div>

<!-- Filters Bar Card -->
<div class="mf-filter-card">
	<div class="row g-3 align-items-center">
		<!-- Live Search Bar -->
		<div class="col-12 col-md-5">
			<div class="mf-search-input-wrap">
				<span class="mf-search-icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="11" cy="11" r="8"/>
						<line x1="21" y1="21" x2="16.65" y2="16.65"/>
					</svg>
				</span>
				<input name="Search" value="@Model?.Query?.Search" type="text" class="form-control mf-form-control" id="txnSearchInput" placeholder="Search by TXN #, description..." />
			</div>
		</div>

		<!-- Type Filter -->
		<div class="col-6 col-md-3">
			<select asp-for="@Model.Query.TransactionType" class="form-select mf-form-control" id="txnTypeFilter" aria-label="Filter by transaction type">
				<option value="">All Types</option>
				<option value="Deposit">Deposit</option>
				<option value="Withdrawal">Withdrawal</option>
				<option value="Transfer">Transfer</option>
			</select>
		</div>

		<!-- Status Filter -->
		<div class="col-6 col-md-3">
			<select asp-for="@Model.Query.Status" class="form-select mf-form-control" id="txnStatusFilter" aria-label="Filter by status">
				<option value="">All Statuses</option>
				<option value="Completed">Completed</option>
				<option value="Pending">Pending</option>
				<option value="Failed">Failed</option>
				@* <option value="Cancelled">Cancelled</option> *@
			</select>
		</div>

		<!-- Reset Button -->
		<div class="col-12 col-md-1 d-flex justify-content-end">
			<button type="button" class="btn btn-outline-secondary w-100 p-2" id="btnClearTxnFilters" title="Clear all filters">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="1 4 1 10 7 10"/>
					<path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
				</svg>
			</button>
		</div>
	</div>
</div>

<!-- Transactions Data Table Section -->
<div class="mf-table-card">
	<div class="table-responsive">
		<table class="table mf-table">
			<thead>
				<tr>
					<th scope="col" style="min-width: 150px;">Date &amp; Time</th>
					<th scope="col" style="min-width: 220px;">Description</th>
					<th scope="col">Type</th>
					<th scope="col" class="text-end">Amount</th>
					<th scope="col" class="text-center">Status</th>
					<th scope="col" class="text-center">Actions</th>
				</tr>
			</thead>
			<tbody id="txnTableBody">
				@foreach (var transaction in Model.Transactions.Items)
				{
					<tr class="mf-txn-data-row"
						data-type="@transaction.TransactionType.ToString().ToLower()" 
						data-status="@transaction.Status.ToString().ToLower()">
						<td>
							<div class="fw-bold text-dark">
								@transaction.TransactionDate.ToString("MMM dd, yyyy")
							</div>

							<small class="text-muted">
								@transaction.TransactionDate.ToString("HH:mm")
							</small>
						</td>
						<td>
							<div class="fw-bold text-dark">
								@transaction.Description
							</div>

							<span class="mf-txn-code">
								@transaction.TransactionNumber
							</span>
						</td>
						<td>
							@if (transaction.TransactionType == TransactionType.Deposit)
							{
								<span class="badge bg-success-subtle text-success fw-bold d-inline-flex align-items-center gap-1">
									<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
										<line x1="12" y1="19" x2="12" y2="5" />
										<polyline points="5 12 12 5 19 12" />
									</svg>
									Deposit
								</span>
							}
							else if (transaction.TransactionType == TransactionType.Withdrawal)
							{
								<span class="badge bg-secondary-subtle text-dark fw-bold d-inline-flex align-items-center gap-1">
									<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
										<line x1="12" y1="5" x2="12" y2="19" />
										<polyline points="19 12 12 19 5 12" />
									</svg>
									Withdrawal
								</span>
							}
							else
							{
								<span class="badge bg-info-subtle text-primary fw-bold d-inline-flex align-items-center gap-1">
									<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M17 1l4 4-4 4" />
										<path d="M3 11V9a4 4 0 0 1 4-4h14" />
									</svg>
									Transfer
								</span>
							}
						</td>
						<td class="text-end fw-extrabold @(transaction.IsIncoming ? "text-success" : "text-navy") fs-6">
							@(transaction.IsIncoming ? "+" : "-") $@transaction.Amount
						</td>
						<td class="text-center">
							<span class="mf-status-badge @transaction.Status.ToString().ToLower()"><span class="dot"></span>@transaction.Status.ToString()</span>
						</td>
						<td class="text-center">
							<a asp-action="Details" asp-route-id="@transaction.Id" asp-route-pageNumber="@Model.Transactions.PageNumber" class="btn btn-sm btn-light fw-semibold">Details</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<!-- Empty State (Hidden unless filters find no results) -->
	<div class="p-5 text-center d-none" id="txnEmptyState">
		<div class="text-muted mb-2">
			<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="11" cy="11" r="8"/>
				<line x1="21" y1="21" x2="16.65" y2="16.65"/>
			</svg>
		</div>
		<h3 class="h6 fw-bold text-dark mb-1">No Transactions Found</h3>
		<p class="text-muted small">Try adjusting your filters or search terms.</p>
	</div>

	<!-- Table Pagination -->
	@{
		var startPage = Math.Max(1, Model.Transactions.PageNumber - 1);
		var endPage = Math.Min(Model.Transactions.TotalPages, startPage + 2);

		if (endPage - startPage < 2)
		{
			startPage = Math.Max(1, endPage - 2);
		}

		var startItem = Model.Transactions.TotalCount == 0
			? 0
			: (Model.Transactions.PageNumber - 1) * Model.Transactions.PageSize + 1;

		var endItem = Math.Min(
			Model.Transactions.PageNumber * Model.Transactions.PageSize,
			Model.Transactions.TotalCount
		);
	}

	<div class="d-flex flex-column flex-sm-row justify-content-between align-items-center p-3 border-top gap-2">

		<span class="small text-muted">
			Showing
			<strong class="text-dark">@startItem-@endItem</strong>
			of
			<strong class="text-dark">@Model.Transactions.TotalCount</strong>
			transactions
		</span>

		<nav aria-label="Transaction pagination">
			<ul class="pagination pagination-sm mb-0">

				<!-- Previous -->
				@if (Model.Transactions.HasPrevious)
				{
					<li class="page-item">
						<a class="page-link"
						   asp-action="Index"
						   asp-route-page="@(Model.Transactions.PageNumber - 1)"
						   asp-route-Search="@Model?.Query?.Search"
						   asp-route-TransactionType="@Model?.Query?.TransactionType"
						   asp-route-Status="@Model?.Query?.Status">
							Previous
						</a>
					</li>
				}
				else
				{
					<li class="page-item disabled">
						<span class="page-link">Previous</span>
					</li>
				}

				<!-- Pages -->
				@for (int i = startPage; i <= endPage; i++)
				{
					<li class="page-item @(i == Model.Transactions.PageNumber ? "active" : "")">
						<a class="page-link"
						   asp-action="Index"
						   asp-route-page="@i"
						   asp-route-Search="@Model?.Query?.Search"
						   asp-route-TransactionType="@Model?.Query?.TransactionType"
						   asp-route-Status="@Model?.Query?.Status">
							@i
						</a>
					</li>
				}

				<!-- Next -->
				@if (Model.Transactions.HasNext)
				{
					<li class="page-item">
						<a class="page-link"
						   asp-action="Index"
						   asp-route-page="@(Model.Transactions.PageNumber + 1)"
						   asp-route-Search="@Model?.Query?.Search"
						   asp-route-TransactionType="@Model?.Query?.TransactionType"
						   asp-route-Status="@Model?.Query?.Status">
							Next
						</a>
					</li>
				}
				else
				{
					<li class="page-item disabled">
						<span class="page-link">Next</span>
					</li>
				}
			</ul>
		</nav>
	</div>
</div>
