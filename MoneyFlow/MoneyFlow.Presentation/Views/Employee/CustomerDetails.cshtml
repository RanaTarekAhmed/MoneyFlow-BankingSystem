@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Customer Profile";
}

<!-- Back link & Page Header -->
<div class="mb-3">
    <a href="/Employee/Customers" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Customer Directory
    </a>
</div>

<!-- Customer Master Header Card -->
<div class="mf-card mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="mf-lookup-avatar" style="width: 64px; height: 64px; font-size: 1.5rem;">SJ</div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="h4 fw-bold text-dark mb-0">Sarah Jenkins</h1>
                    <span class="badge bg-success-subtle text-success fw-bold">Active Customer</span>
                </div>
                <div class="text-muted small mt-1">
                    Customer ID: <strong class="text-dark">CUST-4091</strong> • Member since Oct 2023
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button" class="mf-teller-btn mf-teller-btn-primary btn-open-account-for-cust" data-cust-id="CUST-4091" data-cust-name="Sarah Jenkins">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
                <span>+ Open Bank Account</span>
            </button>
            <a href="/Employee/Operations" class="mf-teller-btn mf-teller-btn-outline">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                <span>Deposit / Withdraw</span>
            </a>
            <button type="button" class="btn btn-outline-danger btn-sm px-3 py-2 fw-bold" onclick="if(window.MoneyFlowToast) window.MoneyFlowToast.warning('Status suspended for Sarah Jenkins');">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Suspend Customer
            </button>
        </div>
    </div>

    <!-- Contact & Identification Ribbon -->
    <div class="row g-3 mt-3 pt-3 border-top">
        <div class="col-12 col-sm-6 col-md-4">
            <span class="text-muted small text-uppercase fw-bold">Email Address</span>
            <div class="fw-bold text-dark text-truncate">sarah.jenkins@example.com</div>
        </div>
        <div class="col-12 col-sm-6 col-md-4">
            <span class="text-muted small text-uppercase fw-bold">National ID</span>
            <div class="fw-bold text-dark">NAT-883921</div>
        </div>
    </div>
</div>

<!-- Linked Accounts Section -->
<div class="row g-4 mb-4">
    <div class="col-12 col-lg-8">
        <div class="mf-table-card">
            <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-light">
                <h2 class="h6 mb-0 fw-bold text-dark">Linked Accounts (2)</h2>
                <button type="button" class="btn btn-sm btn-primary fw-bold btn-open-account-for-cust" data-cust-id="CUST-4091" data-cust-name="Sarah Jenkins">
                    + Open Sub-Account
                </button>
            </div>
            <div class="table-responsive">
                <table class="table mf-table mb-0" id="custLinkedAccountsTable">
                    <thead>
                        <tr>
                            <th>Account # &amp; Type</th>
                            <th>Status</th>
                            <th>Available Balance</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">Current Account</div>
                                <span class="mf-txn-code">MF-100234</span>
                            </td>
                            <td>
                                <span class="badge bg-success-subtle text-success fw-bold">Active</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-6">$14,520.50</div>
                            </td>
                            <td class="text-end">
                                <a href="/Employee/AccountDetails" class="btn btn-sm btn-outline-secondary">Details</a>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">Savings Account</div>
                                <span class="mf-txn-code">MF-100876</span>
                            </td>
                            <td>
                                <span class="badge bg-success-subtle text-success fw-bold">Active</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-6">$52,400.00</div>
                            </td>
                            <td class="text-end">
                                <a href="/Employee/AccountDetails" class="btn btn-sm btn-outline-secondary">Details</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recent Customer Transactions -->
        <div class="mf-table-card mt-4">
            <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-light">
                <h2 class="h6 mb-0 fw-bold text-dark">Recent Transactions Ledger</h2>
                <a href="/Employee/Transactions" class="small text-decoration-none">View All TXNs</a>
            </div>
            <div class="table-responsive">
                <table class="table mf-table mb-0">
                    <thead>
                        <tr>
                            <th>Date &amp; Ref</th>
                            <th>Type</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">Today, 09:45 AM</div>
                                <span class="mf-txn-code">TXN-902184</span>
                            </td>
                            <td>
                                <div>Deposit</div>
                                <div class="small text-muted">Teller Counter</div>
                            </td>
                            <td class="text-end fw-bold text-success">+$2,500.00</td>
                            <td class="text-center"><span class="badge bg-success text-white">Completed</span></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">Yesterday, 04:12 PM</div>
                                <span class="mf-txn-code">TXN-902041</span>
                            </td>
                            <td>
                                <div>Transfer</div>
                                <div class="small text-muted">Customer Transfer</div>
                            </td>
                            <td class="text-end fw-bold text-dark">-$120.00</td>
                            <td class="text-center"><span class="badge bg-success text-white">Completed</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Right Column: Customer Details & Staff Notes -->
    <div class="col-12 col-lg-4">
        <!-- Customer Details Card -->
        <div class="mf-card mb-4">
            <h2 class="h6 fw-bold text-dark border-bottom pb-2 mb-3">Customer Information</h2>
            
            <div class="d-flex flex-column gap-2" style="font-size: 0.85rem;">
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">National ID</span>
                    <span class="fw-bold text-dark">NAT-883921</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Customer Status</span>
                    <span class="badge bg-success text-white">Active</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Total Accounts</span>
                    <span class="fw-bold text-dark">2 Accounts</span>
                </div>
            </div>
        </div>

        <!-- Staff Operational Notes -->
        <div class="mf-card">
            <h2 class="h6 fw-bold text-dark border-bottom pb-2 mb-3">Internal Staff Notes</h2>
            <div class="p-2 bg-light rounded mb-3" style="font-size: 0.8rem;">
                <div class="fw-bold text-dark">Staff Officer:</div>
                <div class="text-muted">Customer visited counter to execute cash deposit.</div>
                <div class="text-muted" style="font-size: 0.7rem;">Aug 28, 2026 11:20 AM</div>
            </div>

            <textarea class="form-control mf-form-control mb-2" rows="2" placeholder="Add an internal note..."></textarea>
            <button type="button" class="btn btn-sm btn-outline-primary w-100 fw-bold" onclick="if(window.MoneyFlowToast) window.MoneyFlowToast.success('Staff note appended to customer log.');">
                Add Note
            </button>
        </div>
    </div>
</div>

<!-- Modal: Open Account with Searchable Customer Select -->
<div class="modal fade" id="openAccountForCustomerModal" tabindex="-1" aria-labelledby="openAccountForCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <div>
                    <h5 class="modal-title fw-bold" id="openAccountForCustomerModalLabel">Open Bank Account for Customer</h5>
                    <div class="small text-white-50">Issue a new Current or Savings account to a customer.</div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="openAccountForm">
                    <!-- 1. Searchable Customer Select Component -->
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-dark d-flex justify-content-between">
                            <span>Select Customer <span class="text-danger">*</span></span>
                            <button type="button" class="btn btn-link p-0 text-decoration-none small d-none" id="btnChangeCustomer">
                                Change / Search Another
                            </button>
                        </label>

                        <!-- Searchable Select Input & Dropdown -->
                        <div class="mf-searchable-select-wrap position-relative" id="customerSearchableSelectBox">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="11" cy="11" r="8"/>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                                    </svg>
                                </span>
                                <input type="text" class="form-control mf-form-control border-start-0" id="inputSearchCustomerModal" placeholder="Type customer name, National ID, or email to search..." autocomplete="off" />
                            </div>

                            <!-- Floating Searchable Results Dropdown -->
                            <div class="mf-searchable-dropdown shadow border rounded" id="customerSearchDropdown" style="display: none;">
                                <div class="mf-searchable-list" id="customerSearchList">
                                    <div class="mf-searchable-item" data-cust-id="CUST-4091" data-cust-name="Sarah Jenkins" data-cust-email="sarah.jenkins@example.com" data-cust-natid="29901011234567">
                                        <div class="mf-lookup-avatar-xs">SJ</div>
                                        <div class="mf-searchable-meta">
                                            <div class="mf-searchable-name">Sarah Jenkins <span class="badge bg-light text-muted border ms-1">CUST-4091</span></div>
                                            <div class="mf-searchable-sub">sarah.jenkins@example.com • Nat ID: 29901011234567</div>
                                        </div>
                                    </div>

                                    <div class="mf-searchable-item" data-cust-id="CUST-4092" data-cust-name="David Miller" data-cust-email="david.miller@techcorp.io" data-cust-natid="29505051234568">
                                        <div class="mf-lookup-avatar-xs" style="background: #0284c7;">DM</div>
                                        <div class="mf-searchable-meta">
                                            <div class="mf-searchable-name">David Miller <span class="badge bg-light text-muted border ms-1">CUST-4092</span></div>
                                            <div class="mf-searchable-sub">david.miller@techcorp.io • Nat ID: 29505051234568</div>
                                        </div>
                                    </div>

                                    <div class="mf-searchable-item" data-cust-id="CUST-4093" data-cust-name="Elena Rostova" data-cust-email="elena.rostova@enterprise.com" data-cust-natid="29811111234569">
                                        <div class="mf-lookup-avatar-xs" style="background: #d97706;">ER</div>
                                        <div class="mf-searchable-meta">
                                            <div class="mf-searchable-name">Elena Rostova <span class="badge bg-light text-muted border ms-1">CUST-4093</span></div>
                                            <div class="mf-searchable-sub">elena.rostova@enterprise.com • Nat ID: 29811111234569</div>
                                        </div>
                                    </div>

                                    <div class="mf-searchable-item" data-cust-id="CUST-4094" data-cust-name="Marcus Vance" data-cust-email="marcus.vance@mail.org" data-cust-natid="29208081234570">
                                        <div class="mf-lookup-avatar-xs" style="background: #dc2626;">MV</div>
                                        <div class="mf-searchable-meta">
                                            <div class="mf-searchable-name">Marcus Vance <span class="badge bg-light text-muted border ms-1">CUST-4094</span></div>
                                            <div class="mf-searchable-sub">marcus.vance@mail.org • Nat ID: 29208081234570</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="p-3 text-center text-muted small" id="customerSearchNoMatch" style="display: none;">
                                    No registered customers match your search query.
                                </div>
                            </div>
                        </div>

                        <!-- Selected Customer Active Banner -->
                        <div class="p-3 bg-light rounded d-flex align-items-center justify-content-between border mt-2" id="selectedCustomerBanner" style="display: none;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="mf-lookup-avatar" style="width: 44px; height: 44px; font-size: 1.1rem;" id="modalCustAvatar">SJ</div>
                                <div>
                                    <div class="fw-bold text-dark fs-6" id="modalCustDisplayName">Sarah Jenkins</div>
                                    <div class="small text-muted">ID: <strong id="modalCustDisplayId">CUST-4091</strong> • Nat ID: <span id="modalCustDisplayNatId">29901011234567</span></div>
                                </div>
                            </div>
                            <span class="badge bg-success-subtle text-success fw-bold px-3 py-1">Selected</span>
                        </div>

                        <input type="hidden" id="selectedCustomerIdVal" value="" />
                    </div>

                    <!-- 2. Account Specifications -->
                    <div class="row g-3 pt-3 border-top">
                        <!-- Account Type strictly matching AccountType enum (Savings, Current) -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-dark">Account Type <span class="text-danger">*</span></label>
                            <select class="form-select mf-form-control" id="modalAccountTypeSelect" required>
                                <option value="Current">Current Account</option>
                                <option value="Savings">Savings Account</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-dark">Initial Deposit Amount ($)</label>
                            <input type="number" step="0.01" min="0" class="form-control mf-form-control" id="modalInitialDepositInput" placeholder="0.00" value="250.00" />
                            <div class="form-text">Initial counter or cash deposit amount.</div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary fw-bold px-4" id="btnConfirmOpenAccount">
                    Create &amp; Issue Account
                </button>
            </div>
        </div>
    </div>
</div>
