@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Staff Profile";
}

<!-- Page Header -->
<div class="mf-page-header d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div>
        <h1 class="mf-page-greeting">Employee Profile &amp; Security</h1>
        <p class="mf-page-subtitle">Inspect your employment details, personal information, and manage your account security.</p>
    </div>
    <div>
        <button type="button" class="btn btn-outline-primary fw-bold" data-bs-toggle="modal" data-bs-target="#editEmployeeProfileModal">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
            Edit Profile Details
        </button>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Left Column: Employment Metadata & Personal Info -->
    <div class="col-12 col-lg-5">
        <!-- Staff Identity Hero Card -->
        <div class="mf-card mb-4">
            <div class="text-center pb-3 border-bottom">
                <div class="mf-lookup-avatar mx-auto mb-3" style="width: 84px; height: 84px; font-size: 2rem; background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);">ST</div>
                <h2 class="h5 fw-bold text-dark mb-0">Staff Officer</h2>
                <div class="text-muted small mb-2">@@staff.officer</div>
                <div class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 mb-2">Bank Staff / Teller</div>
            </div>

            <!-- Employment Information (from Employee entity) -->
            <div class="pt-3">
                <h3 class="text-muted small text-uppercase fw-bold mb-3" style="letter-spacing: 0.05em;">Employment Details (Employee Entity)</h3>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Employee ID</span>
                    <span class="fw-bold text-dark">EMP-4092</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Monthly Base Salary</span>
                    <span class="fw-bold text-success fs-6">$4,500.00 <span class="text-muted small fw-normal">($54,000/yr)</span></span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Hire Date</span>
                    <span class="fw-bold text-dark">15 Jan 2024</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">System Created At</span>
                    <span class="text-dark fw-semibold">15 Jan 2024, 08:30 AM</span>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted small">Employment Status</span>
                    <span class="badge bg-success-subtle text-success fw-bold">Active Staff</span>
                </div>
            </div>
        </div>

        <!-- Personal & Identity Information (from ApplicationUser entity) -->
        <div class="mf-card mb-4">
            <h3 class="h6 fw-bold text-dark border-bottom pb-2 mb-3">Personal Information (ApplicationUser)</h3>
            <div class="d-flex flex-column gap-2" style="font-size: 0.85rem;">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">First Name</span>
                    <span class="fw-bold text-dark" id="dispEmpFirstName">Staff</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Last Name</span>
                    <span class="fw-bold text-dark" id="dispEmpLastName">Officer</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Date of Birth</span>
                    <span class="fw-bold text-dark" id="dispEmpDOB">12 May 1990</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Work Email</span>
                    <div class="text-end">
                        <span class="fw-bold text-dark d-block">officer.staff@moneyflow.bank</span>
                        <span class="badge bg-success-subtle text-success" style="font-size: 0.7rem;">Email Confirmed</span>
                    </div>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted">Residential Address</span>
                    <span class="fw-bold text-dark text-end" style="max-width: 60%;" id="dispEmpAddress">742 Evergreen Terrace, Springfield, OR</span>
                </div>
            </div>
        </div>

        <!-- Security & Authentication -->
        <div class="mf-card">
            <h3 class="h6 fw-bold text-dark border-bottom pb-2 mb-3">Security &amp; Credentials</h3>
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <div class="fw-bold text-dark small">Two-Factor Authentication</div>
                    <div class="text-muted" style="font-size: 0.75rem;">TwoFactorEnabled: True</div>
                </div>
                <span class="badge bg-success text-white">Active</span>
            </div>
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="fw-bold text-dark small">Account Lockout Status</div>
                    <div class="text-muted" style="font-size: 0.75rem;">LockoutEnabled: True (No Failed Attempts)</div>
                </div>
                <span class="badge bg-light text-dark border">Unlocked</span>
            </div>
        </div>
    </div>

    <!-- Right Column: Change Password -->
    <div class="col-12 col-lg-7">
        <div class="mf-card">
            <h2 class="h5 fw-bold text-dark mb-1">Change Employee Password</h2>
            <p class="text-muted small mb-4">Protect your account credentials by adhering to security requirements.</p>

            <form id="empChangePasswordForm">
                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">Current Password <span class="text-danger">*</span></label>
                    <input type="password" class="form-control mf-form-control" id="empCurrentPassword" required placeholder="Enter your current password" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small text-dark">New Password <span class="text-danger">*</span></label>
                    <input type="password" class="form-control mf-form-control" id="empNewPassword" required placeholder="Enter your new secure password" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold small text-dark">Confirm New Password <span class="text-danger">*</span></label>
                    <input type="password" class="form-control mf-form-control" id="empConfirmPassword" required placeholder="Confirm your new password" />
                </div>

                <!-- Password Requirements Checklist -->
                <div class="p-3 bg-light rounded mb-4" id="empPasswordRequirementsBox">
                    <div class="fw-bold text-dark small mb-2">Password must include:</div>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-1" style="font-size: 0.8rem;">
                        <li id="emp-req-len" class="text-muted">
                            <span class="me-1">✕</span> At least 8 characters
                        </li>
                        <li id="emp-req-num" class="text-muted">
                            <span class="me-1">✕</span> At least one number (0-9)
                        </li>
                        <li id="emp-req-special" class="text-muted">
                            <span class="me-1">✕</span> At least one special character (!@@#$%^&amp;*)
                        </li>
                        <li id="emp-req-upper" class="text-muted">
                            <span class="me-1">✕</span> At least one uppercase letter (A-Z)
                        </li>
                        <li id="emp-req-lower" class="text-muted">
                            <span class="me-1">✕</span> At least one lowercase letter (a-z)
                        </li>
                    </ul>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-primary px-4 fw-bold" id="btnUpdateEmpPassword">
                        Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Employee Profile Details -->
<div class="modal fade" id="editEmployeeProfileModal" tabindex="-1" aria-labelledby="editEmployeeProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="editEmployeeProfileModalLabel">Edit Staff Personal Information</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editEmpInfoForm">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-dark">First Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control mf-form-control" value="Staff" id="empEditFirstName" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-dark">Last Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control mf-form-control" value="Officer" id="empEditLastName" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-dark">Date of Birth</label>
                            <input type="date" class="form-control mf-form-control" value="1990-05-12" id="empEditDOB" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-dark">Phone Number</label>
                            <input type="tel" class="form-control mf-form-control" value="+1 (555) 019-4412" id="empEditPhone" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-dark">Residential Address</label>
                            <input type="text" class="form-control mf-form-control" value="742 Evergreen Terrace, Springfield, OR" id="empEditAddress" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary fw-bold" id="btnSaveEmpInfo">Save Changes</button>
            </div>
        </div>
    </div>
</div>
