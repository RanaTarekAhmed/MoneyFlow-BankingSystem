@{
	Layout = "_EmployeeLayout";
	ViewData["Title"] = "Staff Profile";

	var firstName = Model?.ProfileInformation?.FirstName ?? string.Empty;
	var lastName = Model?.ProfileInformation?.LastName ?? string.Empty;
	var employeeInitials = string.Concat(
		string.IsNullOrWhiteSpace(firstName) ? "" : char.ToUpperInvariant(firstName[0]).ToString(),
		string.IsNullOrWhiteSpace(lastName) ? "" : char.ToUpperInvariant(lastName[0]).ToString());
	if (string.IsNullOrWhiteSpace(employeeInitials)) employeeInitials = "E";
}

@model EmployeeProfileVM

<!-- Page Header -->
<div class="mf-page-header d-flex flex-wrap align-items-center justify-content-between gap-3">
	<div>
		<h1 class="mf-page-greeting">Employee Profile &amp; Security</h1>
		<p class="mf-page-subtitle">Inspect your employment details, personal information, and manage your account security.</p>
	</div>
	<div>
		<button type="button" class="btn btn-outline-primary fw-bold" data-bs-toggle="modal" data-bs-target="#editEmployeeProfileModal">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
				<path d="M12 20h9"></path>
				<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
			</svg>
			Edit Profile Details
		</button>
	</div>
</div>

<div class="row g-4 mb-4">
	<!-- Left Column: Employment Metadata & Personal Info -->
	<div class="col-12 col-lg-5">
		<!-- Staff Identity Hero Card -->
		<div class="mf-card mb-4">
			<div class="text-center pb-3 border-bottom">
				<div class="mf-lookup-avatar mx-auto mb-3" style="width: 84px; height: 84px; font-size: 2rem; background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);">@employeeInitials</div>
				<h2 class="h5 fw-bold text-dark mb-0">@($"{Model.ProfileInformation.FirstName} {Model.ProfileInformation.LastName}")</h2>
				<div class="text-muted small mb-2">@($"@{Model.ProfileInformation.FirstName.ToLower()}.{Model.ProfileInformation.LastName.ToLower()}")</div>
				<div class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 mb-2">Bank Staff / Teller</div>
			</div>

			<!-- Employment Information (from Employee entity) -->
			<div class="pt-3">
				<h3 class="text-muted small text-uppercase fw-bold mb-3" style="letter-spacing: 0.05em;">Employment Details</h3>
				<div class="d-flex justify-content-between py-2 border-bottom">
					<span class="text-muted small">Employee ID</span>
					<span class="fw-bold text-dark">@(Model.ProfileInformation.EmployeeId.HasValue ? $"EMP-{Model.ProfileInformation.EmployeeId.Value}" : "Not assigned")</span>
				</div>
				<div class="d-flex justify-content-between py-2 border-bottom">
					<span class="text-muted small">Monthly Base Salary</span>
					<span class="fw-bold text-success fs-6">
					@if (Model.ProfileInformation.Salary.HasValue)
					{
						<span>$@Model.ProfileInformation.Salary.Value.ToString("N2") <span class="text-muted small fw-normal">($@((12 * Model.ProfileInformation.Salary.Value).ToString("N2"))/yr)</span></span>
					}
					else
					{
						<span class="text-muted">Not assigned</span>
					}
				</span>
				</div>
				<div class="d-flex justify-content-between py-2 border-bottom">
					<span class="text-muted small">Hire Date</span>
					<span class="fw-bold text-dark">@(Model.ProfileInformation.HireDate?.ToString("dd MMM yyyy") ?? "Not assigned")</span>
				</div>
				<div class="d-flex justify-content-between py-2 border-bottom">
					<span class="text-muted small">System Created At</span>
					<span class="text-dark fw-semibold">@(Model.ProfileInformation.CreatedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Not available")</span>
				</div>
				<div class="d-flex justify-content-between py-2">
					<span class="text-muted small">Employment Status</span>
					<span class="badge bg-success-subtle text-success fw-bold">Active Staff</span>
				</div>
			</div>
		</div>

		<!-- Personal & Identity Information (from ApplicationUser entity) -->
		<div class="mf-card mb-4">
			<h3 class="h6 fw-bold text-dark border-bottom pb-2 mb-3">Personal Information</h3>
			<div class="d-flex flex-column gap-2" style="font-size: 0.85rem;">
				<div class="d-flex justify-content-between py-2 border-bottom">
					<span class="text-muted">First Name</span>
					<span class="fw-bold text-dark" id="dispEmpFirstName">@Model.ProfileInformation.FirstName</span>
				</div>
				<div class="d-flex justify-content-between py-2 border-bottom">
					<span class="text-muted">Last Name</span>
					<span class="fw-bold text-dark" id="dispEmpLastName">@Model.ProfileInformation.LastName</span>
				</div>
				<div class="d-flex justify-content-between py-2 border-bottom">
					<span class="text-muted">Date of Birth</span>
					<span class="fw-bold text-dark" id="dispEmpDOB">@Model.ProfileInformation.DateOfBirth?.ToString("dd MMM yyyy")</span>
				</div>
				<div class="d-flex justify-content-between py-2 border-bottom">
					<span class="text-muted">Work Email</span>
					<div class="text-end">
						<span class="fw-bold text-dark d-block">@Model.ProfileInformation.Email</span>
					</div>
				</div>
				<div class="d-flex justify-content-between py-2">
					<span class="text-muted">Residential Address</span>
					<span class="fw-bold text-dark text-end" style="max-width: 60%;" id="dispEmpAddress">@Model.ProfileInformation.Address</span>
				</div>
			</div>
		</div>

		<!-- Security & Authentication -->
		<div class="mf-card">
			<h3 class="h6 fw-bold text-dark border-bottom pb-2 mb-3">Security &amp; Credentials</h3>
			<div class="d-flex align-items-center justify-content-between mb-3">
				<div>
					<div class="fw-bold text-dark small">Two-Factor Authentication</div>
					<div class="text-muted" style="font-size: 0.75rem;">TwoFactorEnabled: True</div>
				</div>
				<span class="badge bg-success text-white">Active</span>
			</div>
			<div class="d-flex align-items-center justify-content-between">
				<div>
					<div class="fw-bold text-dark small">Account Lockout Status</div>
					<div class="text-muted" style="font-size: 0.75rem;">LockoutEnabled: True (No Failed Attempts)</div>
				</div>
				<span class="badge bg-light text-dark border">Unlocked</span>
			</div>
		</div>
	</div>

	<!-- Right Column: Change Password -->
	<div class="col-12 col-lg-7">
		<div class="mf-card">
			<h2 class="h5 fw-bold text-dark mb-1">Change Employee Password</h2>
			<p class="text-muted small mb-4">Protect your account credentials by adhering to security requirements.</p>

			<form asp-controller="Employee" asp-action="ChangePassword" method="post" id="empChangePasswordForm">
				@Html.AntiForgeryToken()
				<div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 mb-3 d-none:empty" role="alert"></div>

				<div class="mb-3">
					<label asp-for="@Model.ChangePassword.CurrentPassword" class="form-label fw-bold small text-dark">Current Password <span class="text-danger">*</span></label>
					<input asp-for="@Model.ChangePassword.CurrentPassword" type="password" class="form-control mf-form-control" id="empCurrentPassword" placeholder="••••••••" />
					<span asp-validation-for="@Model.ChangePassword.CurrentPassword" class="text-danger small"></span>
				</div>

				<div class="mb-3">
					<label asp-for="@Model.ChangePassword.NewPassword" class="form-label fw-bold small text-dark">New Password <span class="text-danger">*</span></label>
					<input asp-for="@Model.ChangePassword.NewPassword" type="password" class="form-control mf-form-control" id="newPasswordInput" placeholder="••••••••" />
					<span asp-validation-for="@Model.ChangePassword.NewPassword" class="text-danger small"></span>
				</div>

				<div class="mb-4">
					<label asp-for="@Model.ChangePassword.ConfirmNewPassword" class="form-label fw-bold small text-dark">Confirm New Password <span class="text-danger">*</span></label>
					<input asp-for="@Model.ChangePassword.ConfirmNewPassword" type="password" class="form-control mf-form-control" id="empConfirmPassword" placeholder="••••••••" />
					<span asp-validation-for="@Model.ChangePassword.ConfirmNewPassword" class="text-danger small"></span>
				</div>

				<!-- Password Requirements Checklist -->
				<div class="p-3 bg-light rounded-3 mb-4 small" id="empPasswordRequirementsBox">
					<span class="fw-bold text-dark d-block mb-1">Password must include:</span>
					<ul class="list-unstyled mb-0 d-flex flex-column gap-1 text-muted">
						<li id="req-length">&bull; At least 8 characters</li>
						<li id="req-number">&bull; At least one number (0-9)</li>
						<li id="req-special">&bull; At least one special character (!@@#$%^&*)</li>
						<li id="req-upper">&bull; At least one uppercase letter (A-Z)</li>
						<li id="req-lower">&bull; At least one lowercase letter (a-z)</li>
					</ul>
				</div>

				<button type="submit" class="btn btn-primary w-100 fw-bold" id="btnUpdateEmpPassword">
					Update Password
				</button>
			</form>
		</div>
	</div>
</div>

<!-- Modal: Edit Employee Profile Details -->
<div class="modal fade" id="editEmployeeProfileModal" tabindex="-1" aria-labelledby="editEmployeeProfileModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
			<div class="modal-header border-0 pb-0 pt-4 px-4 align-items-start">
				<div class="d-flex align-items-center gap-3">
					<div class="mf-modal-icon-badge">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
							<circle cx="12" cy="7" r="4"></circle>
						</svg>
					</div>
					<div>
						<h5 class="modal-title fw-bold text-dark mb-0" id="editEmployeeProfileModalLabel">Edit Staff Personal Information</h5>
						<p class="text-muted small mb-0">Update your personal contact details and residential address.</p>
					</div>
				</div>
				<a asp-controller="Employee" asp-action="Profile" class="btn-close" aria-label="Close"></a>
			</div>

			<form asp-controller="Employee" asp-action="Profile" method="post">
				@Html.AntiForgeryToken()
				<input type="hidden" asp-for="ProfileInformation.EmployeeId" />
				<input type="hidden" asp-for="ProfileInformation.Salary" />
				<input type="hidden" asp-for="ProfileInformation.HireDate" />
				<input type="hidden" asp-for="ProfileInformation.CreatedAt" />

				<div class="modal-body p-4">
					<div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 mb-3 d-none:empty" role="alert"></div>

					<div class="row g-3">
						<!-- First Name & Last Name -->
						<div class="col-12 col-md-6">
							<label class="form-label fw-bold small text-dark" asp-for="ProfileInformation.FirstName">First Name <span class="text-danger">*</span></label>
							<input type="text" class="form-control mf-form-control" asp-for="ProfileInformation.FirstName" id="empEditFirstName" placeholder="First name" />
							<span asp-validation-for="ProfileInformation.FirstName" class="text-danger small"></span>
						</div>
						<div class="col-12 col-md-6">
							<label class="form-label fw-bold small text-dark" asp-for="ProfileInformation.LastName">Last Name <span class="text-danger">*</span></label>
							<input type="text" class="form-control mf-form-control" asp-for="ProfileInformation.LastName" id="empEditLastName" placeholder="Last name" />
							<span asp-validation-for="ProfileInformation.LastName" class="text-danger small"></span>
						</div>

						<!-- Email Address -->
						<div class="col-12 col-md-6">
							<label class="form-label fw-bold small text-dark" asp-for="ProfileInformation.Email">Work Email <span class="text-danger">*</span></label>
							<input type="email" class="form-control mf-form-control" asp-for="ProfileInformation.Email" id="empEditEmail" placeholder="name@example.com" />
							<span asp-validation-for="ProfileInformation.Email" class="text-danger small"></span>
						</div>

						<!-- Date of Birth -->
						<div class="col-12 col-md-6">
							<label class="form-label fw-bold small text-dark" asp-for="ProfileInformation.DateOfBirth">Date of Birth <span class="text-danger">*</span></label>
							<input type="date" class="form-control mf-form-control" asp-for="ProfileInformation.DateOfBirth" id="empEditDOB" value="@(Model.ProfileInformation.DateOfBirth?.ToString("yyyy-MM-dd"))" />
							<span asp-validation-for="ProfileInformation.DateOfBirth" class="text-danger small"></span>
						</div>

						<!-- Residential Address -->
						<div class="col-12">
							<label class="form-label fw-bold small text-dark" asp-for="ProfileInformation.Address">Residential Address <span class="text-danger">*</span></label>
							<input type="text" class="form-control mf-form-control" asp-for="ProfileInformation.Address" id="empEditAddress" placeholder="Street address, City, Country" />
							<span asp-validation-for="ProfileInformation.Address" class="text-danger small"></span>
						</div>
					</div>
				</div>

				<div class="modal-footer bg-light px-4 py-3 border-0 d-flex justify-content-end gap-2">
					<a asp-controller="Employee" asp-action="Profile" class="btn btn-outline-secondary px-4 rounded-3">Cancel</a>
					<button type="submit" class="btn btn-primary fw-bold px-4 rounded-3 d-inline-flex align-items-center gap-2" id="btnSaveEmpInfo">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
							<polyline points="17 21 17 13 7 13 7 21"></polyline>
							<polyline points="7 3 7 8 15 8"></polyline>
						</svg>
						<span>Save Changes</span>
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Keys.Any(k => k.StartsWith("ProfileInformation")))
	{
		<script>
			document.addEventListener('DOMContentLoaded', function () {
				const modalEl = document.getElementById('editEmployeeProfileModal');
				if (modalEl && typeof bootstrap !== 'undefined') {
					const modal = new bootstrap.Modal(modalEl);
					modal.show();
				}
			});
		</script>
	}
}
