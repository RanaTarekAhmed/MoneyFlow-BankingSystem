@model CustomerIndexVM

@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Customer Management";
}

<!-- Page Header -->
<div class="mf-page-header d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div>
        <h1 class="mf-page-greeting">Customer Directory</h1>
        <p class="mf-page-subtitle">Search registered customers, inspect account standings, and issue new bank accounts.</p>
    </div>

    <div>
        <button type="button" class="mf-teller-btn mf-teller-btn-primary" data-bs-toggle="modal" data-bs-target="#newCustomerModal" id="btnOpenNewCustModal">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Register New Customer</span>
        </button>
    </div>
</div>

<!-- Filters & Search Bar Card -->
<div class="mf-filter-card">
    <form asp-controller="Employee" asp-action="allCustomers" method="get">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-9">
                <div class="mf-search-input-wrap">
                    <span class="mf-search-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input name="Search" value="@Model?.Search" type="text" class="form-control mf-form-control" id="customerSearchInput" placeholder="Search by customer name, email, National ID, or phone..." />
                </div>
            </div>

            <div class="col-12 col-md-3">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        </div>
    </form>
</div>

<!-- Customer Data Table Section -->
<div class="mf-table-card">
    <div class="table-responsive">
        <table class="table mf-table">
            <thead>
                <tr>
                    <th scope="col" style="min-width: 200px;">Customer</th>
                    <th scope="col">Contact Info</th>
                    <th scope="col">National ID</th>
                    <th scope="col" class="text-center">Accounts</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody id="empCustomerTableBody">
                @if (Model.Customers.Items.Any())
                {
                    foreach (var customer in Model.Customers.Items)
                    {
                        <tr>
                            <!-- Customer -->
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="mf-lookup-avatar" style="width: 38px; height: 38px; font-size: 0.9rem;">
                                        @if (!string.IsNullOrEmpty(customer.FirstName) && !string.IsNullOrEmpty(customer.LastName))
                                        {
                                            @customer.FirstName[0]
                                            @customer.LastName[0]
                                        }
                                    </div>

                                    <div>
                                        <a asp-controller="Employee" asp-action="CustomerDetails" asp-route-id="@customer.Id" class="fw-bold text-dark text-decoration-none">@customer.FirstName @customer.LastName</a>
                                        <div class="small text-muted">ID: CUST-@customer.Id</div>
                                    </div>
                                </div>
                            </td>

                            <!-- Contact Info -->
                            <td>
                                <div>@customer.Email</div>
                                <div class="small text-muted">@customer.PhoneNumber</div>
                            </td>

                            <!-- National ID -->
                            <td>
                                <div class="fw-semibold text-dark">@customer.NationalId</div>
                            </td>

                            <!-- Accounts Count -->
                            <td class="text-center">
                                <span class="badge bg-light text-dark border px-2 py-1">@customer.AccountsCount Accounts</span>
                            </td>

                            <!-- Actions -->
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        Actions
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Employee" asp-action="CustomerOverview" asp-route-id="@customer.Id">
                                                <i class="me-2">🔍</i> Customer Overview
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item btn-open-account-for-cust" href="javascript:void(0);" data-cust-id="@customer.Id"data-cust-name="@customer.FirstName @customer.LastName"data-cust-email="@customer.Email" data-cust-natid="@customer.NationalId">
                                                <i class="me-2">💳</i> + Open Account
                                            </a>
                                        </li>
                                       

                                        <li>
                                            <a class="dropdown-item" asp-controller="Employee" asp-action="Operations">
                                                <i class="me-2">💵</i> Cash Desk Op
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="text-muted">
                                <div class="fw-bold mb-1">No customers found</div>
                                <div class="small">Try changing your search criteria.</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Responsive Pagination Footer -->
    @{
        var startPage = Math.Max(1, Model.Customers.PageNumber - 1);
        var endPage = Math.Min(Model.Customers.TotalPages, startPage + 2);

        if (endPage - startPage < 2)
        {
            startPage = Math.Max(1, endPage - 2);
        }

        var totalCount = Model.Customers.TotalCount;
        var pageNumber = Model.Customers.PageNumber;
        var pageSize = Model.Customers.PageSize;

        var startItem = totalCount == 0 ? 0 : (pageNumber - 1) * pageSize + 1;
        var endItem = Math.Min(pageNumber * pageSize, totalCount);
    }

    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center p-3 border-top gap-2" id="customerPagination">

        <!-- Showing Information -->
        <span class="small text-muted">
            Showing
            <strong class="text-dark">@startItem-@endItem</strong>
            of
            <strong class="text-dark">@totalCount</strong>
            customers
        </span>

        <!-- Pagination -->
        @if (Model.Customers.TotalPages > 1)
        {
            <nav aria-label="Customer Directory Pagination">
                <ul class="pagination pagination-sm mb-0">

                    <!-- Previous -->
                    @if (Model.Customers.HasPrevious)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-controller="Employee" asp-action="allCustomers" asp-route-page="@(Model.Customers.PageNumber - 1)" asp-route-search="@Model.Search">Previous</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">Previous</span>
                        </li>
                    }

                    <!-- Pages -->
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.Customers.PageNumber ? "active" : "")">
                            <a class="page-link" asp-controller="Employee" asp-action="allCustomers" asp-route-page="@i" asp-route-search="@Model.Search">@i</a>
                        </li>
                    }

                    <!-- Next -->
                    @if (Model.Customers.HasNext)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-controller="Employee" asp-action="allCustomers" asp-route-page="@(Model.Customers.PageNumber + 1)" asp-route-search="@Model.Search">Next</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">Next</span>
                        </li>
                    }

                </ul>
            </nav>
        }
    </div>
</div>

<!-- Modal: Register New Customer -->
<div class="modal fade" id="newCustomerModal" tabindex="-1" aria-labelledby="newCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">

            <div class="modal-header bg-light">
                <div>
                    <h5 class="modal-title fw-bold text-dark mb-0" id="newCustomerModalLabel">Register New Banking Customer</h5>
                    <div class="text-muted small">Create customer record and set up initial portal login credentials.</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <form id="newCustomerForm">
                    @Html.AntiForgeryToken()

                    <!-- 1. Personal Information -->
                    <div class="mf-register-section mb-4">
                        <h6 class="mf-register-section-title text-primary fw-bold border-bottom pb-2 mb-3">1. Personal Information</h6>

                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label class="form-label fw-bold small text-dark">First Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control mf-form-control" id="modalRegFirstName" required placeholder="John" />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="form-label fw-bold small text-dark">Last Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control mf-form-control" id="modalRegLastName" required placeholder="Doe" />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="form-label fw-bold small text-dark">Date of Birth <span class="text-danger">*</span></label>
                                <input type="date" class="form-control mf-form-control" id="modalRegDOB" required />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="form-label fw-bold small text-dark">National ID (14 digits) <span class="text-danger">*</span></label>
                                <input type="text" class="form-control mf-form-control" id="modalRegNationalId" required placeholder="29901011234567" pattern="^\d{14}$" />
                                <div class="form-text">Must contain exactly 14 digits.</div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Contact Information -->
                    <div class="mf-register-section mb-4">
                        <h6 class="mf-register-section-title text-primary fw-bold border-bottom pb-2 mb-3">2. Contact Information</h6>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-bold small text-dark">Email Address <span class="text-danger">*</span></label>
                                <input type="email" class="form-control mf-form-control" id="modalRegEmail" required placeholder="john.doe@example.com" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold small text-dark">Residential Address <span class="text-danger">*</span></label>
                                <input type="text" class="form-control mf-form-control" id="modalRegAddress" required placeholder="123 Financial Way, Apt 4B" />
                            </div>
                        </div>
                    </div>

                    <!-- 3. Security -->
                    <div class="mf-register-section mb-2">
                        <h6 class="mf-register-section-title text-primary fw-bold border-bottom pb-2 mb-3">3. Security &amp; Credentials</h6>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-bold small text-dark">Initial Password <span class="text-danger">*</span></label>

                                <div class="input-group">
                                    <input type="password" class="form-control mf-form-control" id="modalRegPassword" required placeholder="••••••••" />

                                    <button class="btn btn-outline-secondary mf-modal-password-toggle-btn" type="button" data-target="modalRegPassword">
                                        <svg class="mf-eye-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>

                                        <svg class="mf-eye-closed d-none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                            <line x1="1" y1="23" x2="23" y2="1"></line>
                                        </svg>
                                    </button>
                                </div>

                                <!-- Password Strength -->
                                <div class="mf-password-meter-wrap mt-2" id="modal-password-meter">
                                    <div class="mf-strength-bars d-flex gap-1 mb-1">
                                        <div class="mf-strength-bar flex-grow-1" id="modal-str-bar-1" style="height: 4px; background-color: #cbd5e1; border-radius: 4px;"></div>
                                        <div class="mf-strength-bar flex-grow-1" id="modal-str-bar-2" style="height: 4px; background-color: #cbd5e1; border-radius: 4px;"></div>
                                        <div class="mf-strength-bar flex-grow-1" id="modal-str-bar-3" style="height: 4px; background-color: #cbd5e1; border-radius: 4px;"></div>
                                    </div>
                                    <span class="small text-muted fw-semibold" id="modal-str-label">Password strength: Weak</span>
                                </div>

                                <!-- Password Requirements -->
                                <div class="p-3 bg-light rounded mt-2 border">
                                    <div class="fw-bold text-dark small mb-2">Password must contain:</div>

                                    <ul class="list-unstyled mb-0 d-flex flex-column gap-1" style="font-size: 0.8rem;">
                                        <li id="modal-req-len" class="text-muted"><span class="me-1">✕</span> At least 8 characters</li>
                                        <li id="modal-req-upper" class="text-muted"><span class="me-1">✕</span> One uppercase letter (A-Z)</li>
                                        <li id="modal-req-lower" class="text-muted"><span class="me-1">✕</span> One lowercase letter (a-z)</li>
                                        <li id="modal-req-num" class="text-muted"><span class="me-1">✕</span> One number (0-9)</li>
                                        <li id="modal-req-special" class="text-muted"><span class="me-1">✕</span> One special character (!@@#$%^&amp;*)</li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Confirm Password -->
                            <div class="col-12">
                                <label class="form-label fw-bold small text-dark">Confirm Password <span class="text-danger">*</span></label>

                                <div class="input-group">
                                    <input type="password" class="form-control mf-form-control" id="modalRegConfirmPassword" required placeholder="••••••••" />

                                    <button class="btn btn-outline-secondary mf-modal-password-toggle-btn" type="button" data-target="modalRegConfirmPassword">
                                        <svg class="mf-eye-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>

                                        <svg class="mf-eye-closed d-none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                            <line x1="1" y1="23" x2="23" y2="1"></line>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary fw-bold px-4" id="btnSaveNewCustomer">Create Customer Account</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <!-- Register Customer Script -->
    <script>
        document.getElementById("btnSaveNewCustomer").addEventListener("click", async function() {

            const form = document.getElementById("newCustomerForm");

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const formData = new FormData();

            formData.append("FirstName", document.getElementById("modalRegFirstName").value);
            formData.append("LastName", document.getElementById("modalRegLastName").value);
            formData.append("DateOfBirth", document.getElementById("modalRegDOB").value);
            formData.append("NationalId", document.getElementById("modalRegNationalId").value);
            formData.append("Email", document.getElementById("modalRegEmail").value);
            formData.append("Address", document.getElementById("modalRegAddress").value);
            formData.append("Password", document.getElementById("modalRegPassword").value);
            formData.append("ConfirmPassword", document.getElementById("modalRegConfirmPassword").value);

            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            formData.append("__RequestVerificationToken", token);

            try {

                const response = await fetch('@Url.Action("RegisterCustomer", "Employee")', {
                    method: "POST",
                    body: formData
                });

                const result = await response.json();

                if (response.ok && result.success) {

                    alert(result.message);

                    const modalElement = document.getElementById("newCustomerModal");
                    const modal = bootstrap.Modal.getInstance(modalElement);

                    modal.hide();

                    form.reset();

                    location.reload();

                } else {

                    console.log(result);
                    alert("Failed to register customer.");

                }

            } catch (error) {

                console.error(error);
                alert("An error occurred while registering the customer.");

            }

        });
    </script>
}



