
@model CustomerDetailsVM
@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Customer Profile";
}

<!-- Back link & Page Header -->
<div class="mb-3">
    <a asp-controller="Employee" asp-action="allCustomers" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Customer Directory
    </a>
</div>

<!-- Customer Master Header Card -->
<div class="mf-card mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="mf-lookup-avatar" style="width: 64px; height: 64px; font-size: 1.5rem;">
                @Model.FirstName[0]@Model.LastName[0]
            </div>

            <div>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="h4 fw-bold text-dark mb-0">@Model.FirstName @Model.LastName</h1>

                    <span class="badge @(Model.Status == "Active" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") fw-bold">
                        @Model.Status Customer
                    </span>
                </div>

                <div class="text-muted small mt-1">
                    Customer ID: <strong class="text-dark">CUST-@Model.Id</strong>
                    • Member since @Model.MemberSince.ToString("MMM yyyy")
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button" class="mf-teller-btn mf-teller-btn-primary btn-open-account-for-cust" data-cust-id="@Model.Id" data-cust-name="@Model.FirstName @Model.LastName">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
                <span>+ Open Bank Account</span>
            </button>

            <a asp-controller="Employee" asp-action="Operations" class="mf-teller-btn mf-teller-btn-outline">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="1" x2="12" y2="23" />
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
                <span>Deposit / Withdraw</span>
            </a>

           
        </div>
    </div>

    <!-- Contact & Identification Ribbon -->
    <div class="row g-3 mt-3 pt-3 border-top">
        <div class="col-12 col-sm-6 col-md-4">
            <span class="text-muted small text-uppercase fw-bold">Email Address</span>
            <div class="fw-bold text-dark text-truncate">@Model.Email</div>
        </div>

        <div class="col-12 col-sm-6 col-md-4">
            <span class="text-muted small text-uppercase fw-bold">National ID</span>
            <div class="fw-bold text-dark">@Model.NationalId</div>
        </div>
    </div>
</div>

<!-- Linked Accounts Section -->
<div class="row g-4 mb-4">
    <div class="col-12 col-lg-8">
        <div class="mf-table-card">
            <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-light">
                <h2 class="h6 mb-0 fw-bold text-dark">Linked Accounts (@Model.Accounts.Count)</h2>

                <button type="button" class="btn btn-sm btn-primary fw-bold btn-open-account-for-cust" data-cust-id="@Model.Id" data-cust-name="@Model.FirstName @Model.LastName">
                    + Open Sub-Account
                </button>
            </div>

            <div class="table-responsive">
                <table class="table mf-table mb-0" id="custLinkedAccountsTable">
                    <thead>
                        <tr>
                            <th>Account # &amp; Type</th>
                            <th>Status</th>
                            <th>Available Balance</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Accounts.Any())
                        {
                            foreach (var account in Model.Accounts)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@account.AccountType Account</div>
                                        <span class="mf-txn-code">@account.AccountNumber</span>
                                    </td>

                                    <td>
                                        <span class="badge bg-success-subtle text-success fw-bold">
                                            @account.Status
                                        </span>
                                    </td>

                                    <td>
                                        <div class="fw-bold text-dark fs-6">
                                            $@account.Balance.ToString("N2")
                                        </div>
                                    </td>

                                    <td class="text-end">
                                        <a asp-controller="Account" asp-action="EmployeeDetails" asp-route-id="@account.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No active accounts found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recent Customer Transactions -->
        <div class="mf-table-card mt-4">
            <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-light">
                <h2 class="h6 mb-0 fw-bold text-dark">Recent Transactions Ledger</h2>
                <a asp-controller="Transaction" asp-action="EmployeeIndex" asp-route-search='@(Model.FirstName + " " + Model.LastName)' class="small text-decoration-none">View All TXNs</a>
            </div>

            <div class="table-responsive">
                <table class="table mf-table mb-0">
                    <thead>
                        <tr>
                            <th>Date &amp; Ref</th>
                            <th>Type</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Transactions.Any())
                        {
                            foreach (var transaction in Model.Transactions)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">
                                            @transaction.TransactionDate.ToString("MMM dd, yyyy hh:mm tt")
                                        </div>
                                        <span class="mf-txn-code">@transaction.TransactionNumber</span>
                                    </td>

                                    <td>
                                        <div>@transaction.TransactionType</div>
                                        @if (!string.IsNullOrEmpty(transaction.Description))
                                        {
                                            <div class="small text-muted">@transaction.Description</div>
                                        }
                                    </td>

                                    <td class="text-end fw-bold @(transaction.TransactionType.ToString() == "Deposit" ? "text-success" : "text-dark")">
                                        @(transaction.TransactionType.ToString() == "Deposit" ? "+" : "-")$@transaction.Amount.ToString("N2")
                                    </td>

                                    <td class="text-center">
                                        <span class="badge bg-success text-white">
                                            @transaction.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No transactions found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Right Column: Customer Details & Staff Notes -->
    <div class="col-12 col-lg-4">
        <!-- Customer Details Card -->
        <div class="mf-card mb-4">
            <h2 class="h6 fw-bold text-dark border-bottom pb-2 mb-3">Customer Information</h2>

            <div class="d-flex flex-column gap-2" style="font-size: 0.85rem;">
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">National ID</span>
                    <span class="fw-bold text-dark">@Model.NationalId</span>
                </div>

                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Customer Status</span>
                    <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-danger") text-white">
                        @Model.Status
                    </span>
                </div>

                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Total Accounts</span>
                    <span class="fw-bold text-dark">@Model.Accounts.Count Accounts</span>
                </div>
            </div>
        </div>

        
    </div>
</div>

<!-- Modal: Open Account with Searchable Customer Select (Shared Partial) -->
<partial name="~/Views/Account/_OpenAccountModal.cshtml" model='ViewBag.OpenAccountModel as MoneyFlow.Business.ViewModels.Accounts.OpenAccountVM ?? new MoneyFlow.Business.ViewModels.Accounts.OpenAccountVM { ReturnUrl = "/Employee/CustomerOverview/" + Model.Id, CustomerId = Model.Id, CustomerName = Model.FirstName + " " + Model.LastName }' />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (ViewBag.ShowOpenAccountModal == true)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const modalEl = document.getElementById('openAccountForCustomerModal');
                if (modalEl && typeof bootstrap !== 'undefined') {
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                }
            });
        </script>
    }
}
