@{
	Layout = "_CustomerLayout";
	ViewData["Title"] = "Customer Profile";
}

@model CustomerProfileVM

<!-- Profile Hero Card -->
<div class="mf-profile-header-card">
	<div class="d-flex align-items-center gap-3">
		<div class="mf-profile-avatar-large">
			@($"{char.ToUpper(Model.ProfileInformation.FirstName[0])}{char.ToUpper(Model.ProfileInformation.LastName[0])}")
		</div>
		<div>
			<h1 class="h3 fw-bold mb-1 text-white" id="heroCustomerName">@($"{Model.ProfileInformation.FirstName} {Model.ProfileInformation.LastName}")</h1>
			<p class="mb-1 opacity-75 small">Customer ID: <span class="font-monospace fw-bold">CUST-@Model.ProfileInformation.CustomerId</span></p>
			<span class="badge bg-white text-navy fw-bold small px-2 py-1">Verified Personal Customer</span>
		</div>
	</div>
	<div class="text-md-end opacity-90 small">
		<div>Member Since: <strong>@Model.ProfileInformation.CreatedAt.ToString("MMMM dd, yyyy")</strong></div>
	</div>
</div>

<!-- Alert for successfully updated profile -->
<div class="alert alert-success d-none mb-4" id="profileUpdateSuccess" role="alert">
	<strong>Success!</strong> Your personal information has been updated.
</div>

<div class="row g-4">
	<!-- Left Column: Personal Information (View Card + Modal Trigger) -->
	<div class="col-12 col-lg-7">
		<div class="mf-card p-4">
			<div class="d-flex align-items-center justify-content-between mb-3">
				<h2 class="h5 fw-bold text-dark mb-0">Personal Information</h2>
				<button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-2" id="btnEditProfile" data-bs-toggle="modal" data-bs-target="#editPersonalInfoModal">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
						<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
					</svg>
					<span>Edit Details</span>
				</button>
			</div>

			<!-- View Details -->
			<div id="profileViewMode">
				<div class="mf-info-row">
					<span class="mf-info-label">First Name</span>
					<span class="mf-info-val" id="viewFirstName">@Model.ProfileInformation.FirstName</span>
				</div>
				<div class="mf-info-row">
					<span class="mf-info-label">Last Name</span>
					<span class="mf-info-val" id="viewLastName">@Model.ProfileInformation.LastName</span>
				</div>
				<div class="mf-info-row">
					<span class="mf-info-label">Email Address</span>
					<span class="mf-info-val" id="viewEmail">@Model.ProfileInformation.Email</span>
				</div>
				<div class="mf-info-row">
					<span class="mf-info-label">Residential Address</span>
					<span class="mf-info-val text-end" id="viewAddress">@Model.ProfileInformation.Address</span>
				</div>
				<div class="mf-info-row">
					<span class="mf-info-label">Date of Birth</span>
					<span class="mf-info-val" id="viewDob">@Model.ProfileInformation.DateOfBirth?.ToString("MMM d, yyyy")</span>
				</div>
				<div class="mf-info-row">
					<span class="mf-info-label">National ID</span>
					<div class="d-flex align-items-center gap-2">
						<span class="mf-info-val font-monospace" id="maskedNationalId" data-full-id="@Model.ProfileInformation.NationalId">••••••••••@Model.ProfileInformation.NationalId[^4..]</span>
						<button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="btnToggleNId">Show</button>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Right Column: Change Password & Security -->
	<div class="col-12 col-lg-5">
		<div class="mf-card p-4">
			<h2 class="h5 fw-bold text-dark mb-3">Change Password</h2>
			<form id="changePasswordForm" asp-controller="Customer" asp-action="ChangePassword" method="post">
				@Html.AntiForgeryToken()
				<div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 mb-3 d-none:empty" role="alert"></div>

				<div class="mb-3">
					<label class="mf-form-label" asp-for="ChangePassword.CurrentPassword">Current Password <span class="text-danger">*</span></label>
					<input type="password" class="form-control mf-form-control" asp-for="ChangePassword.CurrentPassword" id="currentPassword" placeholder="••••••••"/>
					<span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger small"></span>
				</div>
				<div class="mb-3">
					<label class="mf-form-label" asp-for="ChangePassword.NewPassword">New Password <span class="text-danger">*</span></label>
					<input type="password" class="form-control mf-form-control" asp-for="ChangePassword.NewPassword" id="newPasswordInput" placeholder="••••••••"/>
					<span asp-validation-for="ChangePassword.NewPassword" class="text-danger small"></span>
				</div>
				<div class="mb-3">
					<label class="mf-form-label" asp-for="ChangePassword.ConfirmNewPassword">Confirm New Password <span class="text-danger">*</span></label>
					<input type="password" class="form-control mf-form-control" asp-for="ChangePassword.ConfirmNewPassword" id="confirmPasswordInput" placeholder="••••••••"/>
					<span asp-validation-for="ChangePassword.ConfirmNewPassword" class="text-danger small"></span>
				</div>

				<!-- Password Requirements Checklist -->
				<div class="p-3 bg-light rounded-3 mb-4 small">
					<span class="fw-bold text-dark d-block mb-1">Password must include:</span>
					<ul class="list-unstyled mb-0 d-flex flex-column gap-1 text-muted">
						<li id="req-length">&bull; At least 8 characters</li>
						<li id="req-number">&bull; At least one number (0-9)</li>
						<li id="req-special">&bull; At least one special character (!@@#$%^&*)</li>
						<li id="req-upper">&bull; At least one uppercase letter (A-Z)</li>
						<li id="req-lower">&bull; At least one lowercase letter (a-z)</li>
					</ul>
				</div>

				<button type="submit" class="btn mf-btn-primary w-100">Update Password</button>
			</form>
		</div>
	</div>
</div>

<!-- ==========================================================================
     Edit Personal Information Modal
     ========================================================================== -->
<div class="modal fade mf-modal" id="editPersonalInfoModal" tabindex="-1" aria-labelledby="editPersonalInfoModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
			<div class="modal-header border-0 pb-0 pt-4 px-4 align-items-start">
				<div class="d-flex align-items-center gap-3">
					<div class="mf-modal-icon-badge">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
							<circle cx="12" cy="7" r="4"></circle>
						</svg>
					</div>
					<div>
						<h2 class="modal-title h5 fw-bold text-dark mb-0" id="editPersonalInfoModalLabel">Edit Personal Information</h2>
						<p class="text-muted small mb-0">Update your personal contact details and residential address.</p>
					</div>
				</div>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<form id="editPersonalInfoForm" asp-controller="Customer" asp-action="Profile" method="post">
				@Html.AntiForgeryToken()
				<input type="hidden" asp-for="ProfileInformation.CustomerId" id="editCustomerId" />
				<input type="hidden" asp-for="ProfileInformation.NationalId" id="editHiddenNationalId" />
				<input type="hidden" asp-for="ProfileInformation.CreatedAt" id="editCreatedAt" />

				<div class="modal-body p-4">
					<div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 mb-3 d-none:empty" role="alert"></div>

					<div class="row g-3">
						<!-- First Name & Last Name -->
						<div class="col-12 col-md-6">
							<label class="mf-form-label" asp-for="ProfileInformation.FirstName">First Name <span class="text-danger">*</span></label>
							<input type="text" class="form-control mf-form-control" asp-for="ProfileInformation.FirstName" id="editFirstName" placeholder="First name" value="@Model.ProfileInformation.FirstName" required />
							<span asp-validation-for="ProfileInformation.FirstName" class="text-danger small"></span>
						</div>
						<div class="col-12 col-md-6">
							<label class="mf-form-label" asp-for="ProfileInformation.LastName">Last Name <span class="text-danger">*</span></label>
							<input type="text" class="form-control mf-form-control" asp-for="ProfileInformation.LastName" id="editLastName" placeholder="Last name" value="@Model.ProfileInformation.LastName" required />
							<span asp-validation-for="ProfileInformation.LastName" class="text-danger small"></span>
						</div>

						<!-- Email Address -->
						<div class="col-12 col-md-6">
							<label class="mf-form-label" asp-for="ProfileInformation.Email">Email Address <span class="text-danger">*</span></label>
							<input type="email" class="form-control mf-form-control" asp-for="ProfileInformation.Email" id="editEmail" placeholder="name@example.com" value="@Model.ProfileInformation.Email" required />
							<span asp-validation-for="ProfileInformation.Email" class="text-danger small"></span>
						</div>

						<!-- Date of Birth -->
						<div class="col-12 col-md-6">
							<label class="mf-form-label" asp-for="ProfileInformation.DateOfBirth">Date of Birth <span class="text-danger">*</span></label>
							<input type="date" class="form-control mf-form-control" asp-for="ProfileInformation.DateOfBirth" id="editDob" value="@(Model.ProfileInformation.DateOfBirth?.ToString("yyyy-MM-dd"))" required />
							<span asp-validation-for="ProfileInformation.DateOfBirth" class="text-danger small"></span>
						</div>

						<!-- Residential Address -->
						<div class="col-12">
							<label class="mf-form-label" asp-for="ProfileInformation.Address">Residential Address <span class="text-danger">*</span></label>
							<input type="text" class="form-control mf-form-control" asp-for="ProfileInformation.Address" id="editAddress" placeholder="Street address, City, Country" value="@Model.ProfileInformation.Address" required />
							<span asp-validation-for="ProfileInformation.Address" class="text-danger small"></span>
						</div>

						<!-- National ID (Locked / Read-Only Display) -->
						<div class="col-12">
							<div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
								<div class="d-flex align-items-center gap-2">
									<div class="text-muted">
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
											<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
										</svg>
									</div>
									<div>
										<div class="small fw-bold text-dark">National ID (KYC Verified)</div>
										<div class="small text-muted font-monospace">••••••••••@Model.ProfileInformation.NationalId[^4..]</div>
									</div>
								</div>
								<span class="badge bg-secondary-subtle text-secondary small px-2 py-1">Locked</span>
							</div>
							<div class="form-text text-muted small mt-1">To update government-issued identity or National ID, please visit a branch or contact official support.</div>
						</div>
					</div>
				</div>

				<div class="modal-footer bg-light px-4 py-3 border-0 d-flex justify-content-end gap-2">
					<button type="button" class="btn btn-outline-secondary px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn mf-btn-primary px-4 rounded-3 d-inline-flex align-items-center gap-2" id="btnSavePersonalInfo">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
							<polyline points="17 21 17 13 7 13 7 21"></polyline>
							<polyline points="7 3 7 8 15 8"></polyline>
						</svg>
						<span>Save Changes</span>
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Keys.Any(k => k.StartsWith("ProfileInformation")))
	{
		<script>
			document.addEventListener('DOMContentLoaded', function () {
				const modalEl = document.getElementById('editPersonalInfoModal');
				if (modalEl && typeof bootstrap !== 'undefined') {
					const modal = new bootstrap.Modal(modalEl);
					modal.show();
				}
			});
		</script>
	}
}
