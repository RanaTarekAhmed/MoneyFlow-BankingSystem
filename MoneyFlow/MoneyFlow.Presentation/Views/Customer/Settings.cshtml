@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Settings";
}

<!-- Page Header -->
<div class="mf-page-header">
    <h1 class="mf-page-greeting">Account Settings</h1>
    <p class="mf-page-subtitle">Configure your security preferences, alert notifications, and active sessions.</p>
</div>

<div class="row g-4">
    <!-- Security Settings -->
    <div class="col-12 col-lg-6">
        <div class="mf-card p-4 mb-4">
            <h2 class="h5 fw-bold text-dark mb-3">Security &amp; Authentication</h2>
            
            <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
                <div>
                    <div class="fw-bold text-dark">Two-Factor Authentication (2FA)</div>
                    <small class="text-muted">Require an authentication code for every login and transfer.</small>
                </div>
                <div class="form-check form-switch fs-5">
                    <input class="form-check-input" type="checkbox" role="switch" id="switch2FA" checked />
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
                <div>
                    <div class="fw-bold text-dark">Biometric Passkey Authentication</div>
                    <small class="text-muted">Use Face ID or Windows Hello for instant sign-in.</small>
                </div>
                <div class="form-check form-switch fs-5">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchBiometric" checked />
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between pt-3">
                <div>
                    <div class="fw-bold text-dark">Automatic Session Timeout</div>
                    <small class="text-muted">Automatically lock session after 15 minutes of inactivity.</small>
                </div>
                <div class="form-check form-switch fs-5">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchTimeout" checked />
                </div>
            </div>
        </div>

        <!-- Notification Preferences -->
        <div class="mf-card p-4">
            <h2 class="h5 fw-bold text-dark mb-3">Notification Preferences</h2>

            <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
                <div>
                    <div class="fw-bold text-dark">Email Transfer Receipts</div>
                    <small class="text-muted">Receive a confirmation email for every outgoing transfer.</small>
                </div>
                <div class="form-check form-switch fs-5">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchNotifTransfer" checked />
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
                <div>
                    <div class="fw-bold text-dark">Deposit &amp; Withdrawal Alerts</div>
                    <small class="text-muted">Instant notification when funds enter or leave your account.</small>
                </div>
                <div class="form-check form-switch fs-5">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchNotifDeposit" checked />
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between pt-3">
                <div>
                    <div class="fw-bold text-dark">Security Alerts</div>
                    <small class="text-muted">Immediate warnings for new logins or password changes.</small>
                </div>
                <div class="form-check form-switch fs-5">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchNotifSecurity" checked disabled />
                </div>
            </div>
        </div>
    </div>

    <!-- Active Sessions & Device Management -->
    <div class="col-12 col-lg-6">
        <div class="mf-card p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="h5 fw-bold text-dark mb-0">Active Sessions</h2>
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="alert('All other sessions signed out.');">Sign Out Other Sessions</button>
            </div>

            <!-- Current Session -->
            <div class="p-3 bg-light rounded-3 mb-3 border">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <div class="d-flex align-items-center gap-2">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                            <rect x="2" y="3" width="20" height="14" rx="2"/>
                            <line x1="8" y1="21" x2="16" y2="21"/>
                            <line x1="12" y1="17" x2="12" y2="21"/>
                        </svg>
                        <strong class="text-dark">Chrome on Windows (Current Device)</strong>
                    </div>
                    <span class="badge bg-success-subtle text-success">Active Now</span>
                </div>
                <div class="small text-muted">New York, USA &bull; IP: 197.38.112.44</div>
            </div>

            <!-- Other Session -->
            <div class="p-3 bg-white rounded-3 border mb-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <div class="d-flex align-items-center gap-2">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted">
                            <rect x="5" y="2" width="14" height="20" rx="2"/>
                            <line x1="12" y1="18" x2="12.01" y2="18"/>
                        </svg>
                        <strong class="text-dark">Safari on iPhone 15 Pro</strong>
                    </div>
                    <small class="text-muted">Active Yesterday</small>
                </div>
                <div class="small text-muted">New York, USA &bull; IP: 197.38.112.45</div>
            </div>
        </div>
    </div>
</div>
