@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Transactions";
}

<!-- Page Header -->
<div class="mf-page-header">
    <h1 class="mf-page-greeting">Transaction History</h1>
    <p class="mf-page-subtitle">View, search, and track all deposits, withdrawals, and account transfers.</p>
</div>

<!-- Filters Bar Card -->
<div class="mf-filter-card">
    <div class="row g-3 align-items-center">
        <!-- Live Search Bar -->
        <div class="col-12 col-md-5">
            <div class="mf-search-input-wrap">
                <span class="mf-search-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </span>
                <input type="text" class="form-control mf-form-control" id="txnSearchInput" placeholder="Search by TXN #, description..." />
            </div>
        </div>

        <!-- Type Filter -->
        <div class="col-6 col-md-3">
            <select class="form-select mf-form-control" id="txnTypeFilter" aria-label="Filter by transaction type">
                <option value="all" selected>All Types</option>
                <option value="deposit">Deposit</option>
                <option value="withdrawal">Withdrawal</option>
                <option value="transfer">Transfer</option>
            </select>
        </div>

        <!-- Status Filter -->
        <div class="col-6 col-md-3">
            <select class="form-select mf-form-control" id="txnStatusFilter" aria-label="Filter by status">
                <option value="all" selected>All Statuses</option>
                <option value="completed">Completed</option>
                <option value="pending">Pending</option>
                <option value="failed">Failed</option>
            </select>
        </div>

        <!-- Reset Button -->
        <div class="col-12 col-md-1 d-flex justify-content-end">
            <button type="button" class="btn btn-outline-secondary w-100 p-2" id="btnClearTxnFilters" title="Clear all filters">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="1 4 1 10 7 10"/>
                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                </svg>
            </button>
        </div>
    </div>
</div>

<!-- Transactions Data Table Section -->
<div class="mf-table-card">
    <div class="table-responsive">
        <table class="table mf-table">
            <thead>
                <tr>
                    <th scope="col" style="min-width: 150px;">Date &amp; Time</th>
                    <th scope="col" style="min-width: 220px;">Description</th>
                    <th scope="col">Type</th>
                    <th scope="col" class="text-end">Amount</th>
                    <th scope="col" class="text-center">Status</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody id="txnTableBody">
                <!-- Row 1: Deposit -->
                <tr class="mf-txn-data-row" data-type="deposit" data-status="completed">
                    <td>
                        <div class="fw-bold text-dark">Oct 24, 2023</div>
                        <small class="text-muted">14:32 EST</small>
                    </td>
                    <td>
                        <div class="fw-bold text-dark">Cash Deposit</div>
                        <span class="mf-txn-code">TXN-8472910</span>
                    </td>
                    <td>
                        <span class="badge bg-success-subtle text-success fw-bold d-inline-flex align-items-center gap-1">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="19" x2="12" y2="5"/>
                                <polyline points="5 12 12 5 19 12"/>
                            </svg>
                            Deposit
                        </span>
                    </td>
                    <td class="text-end fw-extrabold text-success fs-6">+ $5,000.00</td>
                    <td class="text-center">
                        <span class="mf-status-badge completed"><span class="dot"></span>Completed</span>
                    </td>
                    <td class="text-center">
                        <a href="/Customer/TransactionDetails?id=TXN-8472910" class="btn btn-sm btn-light fw-semibold">Details</a>
                    </td>
                </tr>

                <!-- Row 2: Withdrawal -->
                <tr class="mf-txn-data-row" data-type="withdrawal" data-status="completed">
                    <td>
                        <div class="fw-bold text-dark">Oct 23, 2023</div>
                        <small class="text-muted">09:15 EST</small>
                    </td>
                    <td>
                        <div class="fw-bold text-dark">Cash Withdrawal</div>
                        <span class="mf-txn-code">TXN-8472885</span>
                    </td>
                    <td>
                        <span class="badge bg-secondary-subtle text-dark fw-bold d-inline-flex align-items-center gap-1">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"/>
                                <polyline points="19 12 12 19 5 12"/>
                            </svg>
                            Withdrawal
                        </span>
                    </td>
                    <td class="text-end fw-extrabold text-navy fs-6">- $1,000.00</td>
                    <td class="text-center">
                        <span class="mf-status-badge completed"><span class="dot"></span>Completed</span>
                    </td>
                    <td class="text-center">
                        <a href="/Customer/TransactionDetails?id=TXN-8472885" class="btn btn-sm btn-light fw-semibold">Details</a>
                    </td>
                </tr>

                <!-- Row 3: Transfer Pending -->
                <tr class="mf-txn-data-row" data-type="transfer" data-status="pending">
                    <td>
                        <div class="fw-bold text-dark">Oct 23, 2023</div>
                        <small class="text-muted">08:45 EST</small>
                    </td>
                    <td>
                        <div class="fw-bold text-dark">Internal Transfer to Vault</div>
                        <span class="mf-txn-code">TXN-8472850</span>
                    </td>
                    <td>
                        <span class="badge bg-info-subtle text-primary fw-bold d-inline-flex align-items-center gap-1">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 1l4 4-4 4"/>
                                <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
                            </svg>
                            Transfer
                        </span>
                    </td>
                    <td class="text-end fw-extrabold text-navy fs-6">- $2,500.00</td>
                    <td class="text-center">
                        <span class="mf-status-badge pending"><span class="dot"></span>Pending</span>
                    </td>
                    <td class="text-center">
                        <a href="/Customer/TransactionDetails?id=TXN-8472850" class="btn btn-sm btn-light fw-semibold">Details</a>
                    </td>
                </tr>

                <!-- Row 4: Failed Withdrawal -->
                <tr class="mf-txn-data-row" data-type="withdrawal" data-status="failed">
                    <td>
                        <div class="fw-bold text-dark">Oct 21, 2023</div>
                        <small class="text-muted">16:20 EST</small>
                    </td>
                    <td>
                        <div class="fw-bold text-dark">International Vendor Payment</div>
                        <span class="mf-txn-code">TXN-8471992</span>
                    </td>
                    <td>
                        <span class="badge bg-secondary-subtle text-dark fw-bold d-inline-flex align-items-center gap-1">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"/>
                                <polyline points="19 12 12 19 5 12"/>
                            </svg>
                            Withdrawal
                        </span>
                    </td>
                    <td class="text-end fw-extrabold text-muted fs-6">- $450.00</td>
                    <td class="text-center">
                        <span class="mf-status-badge failed"><span class="dot"></span>Failed</span>
                    </td>
                    <td class="text-center">
                        <a href="/Customer/TransactionDetails?id=TXN-8471992" class="btn btn-sm btn-light fw-semibold">Details</a>
                    </td>
                </tr>

                <!-- Row 5: Deposit -->
                <tr class="mf-txn-data-row" data-type="deposit" data-status="completed">
                    <td>
                        <div class="fw-bold text-dark">Oct 20, 2023</div>
                        <small class="text-muted">11:05 EST</small>
                    </td>
                    <td>
                        <div class="fw-bold text-dark">Stripe Payout</div>
                        <span class="mf-txn-code">TXN-8471504</span>
                    </td>
                    <td>
                        <span class="badge bg-success-subtle text-success fw-bold d-inline-flex align-items-center gap-1">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="19" x2="12" y2="5"/>
                                <polyline points="5 12 12 5 19 12"/>
                            </svg>
                            Deposit
                        </span>
                    </td>
                    <td class="text-end fw-extrabold text-success fs-6">+ $3,000.00</td>
                    <td class="text-center">
                        <span class="mf-status-badge completed"><span class="dot"></span>Completed</span>
                    </td>
                    <td class="text-center">
                        <a href="/Customer/TransactionDetails?id=TXN-8471504" class="btn btn-sm btn-light fw-semibold">Details</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Empty State (Hidden unless filters find no results) -->
    <div class="p-5 text-center d-none" id="txnEmptyState">
        <div class="text-muted mb-2">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
        </div>
        <h3 class="h6 fw-bold text-dark mb-1">No Transactions Found</h3>
        <p class="text-muted small">Try adjusting your filters or search terms.</p>
    </div>

    <!-- Table Pagination -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center p-3 border-top gap-2">
        <span class="small text-muted">Showing <strong class="text-dark">1-5</strong> of <strong class="text-dark">24</strong> transactions</span>
        <nav aria-label="Transaction pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item disabled"><a class="page-link" href="#" tabindex="-1">Previous</a></li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item"><a class="page-link" href="#">Next</a></li>
            </ul>
        </nav>
    </div>
</div>
